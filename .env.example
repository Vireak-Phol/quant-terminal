# Copy to .env (git-ignored). The bridge reads ONLY the keys in this file from .env;
# everything else is a shell environment variable (see the bottom of this file).

# ── OANDA v20 (needed only to use the OANDA provider) ────────────────
# Token: OANDA hub → "Manage API Access". Never commit real values.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# practice | live
OANDA_ENV=practice

# ── Telegram alerts (opt-in; leave blank to disable) ─────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated tiers to push: A_PLUS, STRUCTURAL
ALERT_TIERS=A_PLUS

# ── Shell-environment-only options (NOT read from this file) ─────────
# MARKET_PROVIDER=binance|oanda   overrides the UI choice saved in data/config.json
# BRIDGE_HOST=localhost           socket accepts unauthenticated control commands;
#                                 only widen (0.0.0.0) on a trusted network
# BRIDGE_PORT=8765
# BRIDGE_ALLOWED_ORIGINS=         extra browser origins, comma-separated
# OANDA_HISTORY_DAYS=180          OANDA backfill window for the engine/backtest
