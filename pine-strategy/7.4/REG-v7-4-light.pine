int boxLeftOffset = input.int(2, "Box Left Offset (Bars)", minval=0, maxval=50, group=grp_vis_fvg, tooltip="Move boxes/labels to the right to clear candles")
int textTransparency = input.int(40, "Label/Text Transparency", minval=0, maxval=100, group=grp_vis_fvg)

