
// FVG + RPD + SMC + LIQ + REG  —  v7.4 (Data-Level 2/3 build)
// ============================================================================================
// ═══ XAUUSD MICRO-ACCOUNT PRESET (SPEC §6, locked) ═══
// Role: STRUCTURE/CONTEXT OVERLAY ONLY. OSC-VIP v7.3 owns every directional instruction
// (A+ arrows, trade boxes, alerts). REG provides zones, sweeps, OBs and its calibrated ledger.
// Defaults flipped for the preset: Visual Density = Minimalist (Clean), Optimize for Gold
// Scalping = ON (WP-D2). Ledger expectancy is NET of spread (25 ticks) + commission (WP-C3);
// calibrated win rates render GRAY + (warmup) until n >= 15 per signal type (WP-C2).
// ============================================================================================
// Phases: 0=triage/repaint-fix  1=input cut  2=signal ledger/calibration  3=order-flow proxy
// 1. FVG Breaker Pro - Detects Fair Value Gaps and Breaker patterns
// 2. RPD - Calibrated (empirical) reversal detection
// 3. SMC - Market structure, order blocks, gaps, and exhaustion
// 4. Liquidity Zones - Identifies high liquidity zones
// 5. REG - Regression
// All systems can run independently or work together with optional filtering

//@version=6
indicator("UIS-VIP v7.4", overlay = true, max_lines_count = 500, max_boxes_count = 2000, max_labels_count = 500, max_bars_back = 5000, precision = 4)


// MASTER TOGGLES


grp_master = "🎛️ Master Controls"
// 0. Repaint Lock — when ON, ALL signal/drawing logic waits for bar close.
//    Live behavior then == backtest behavior. Recommended ON.
bool confirmedOnly      = input.bool(true, "🔒 Confirmed-Only (no repaint)", group=grp_master, tooltip="Gate every signal on barstate.isconfirmed so live == backtest. Disable only for intrabar experimentation.")
// Single source of truth for "is this bar finalized?" — used across the whole script.
bool barConfirmed       = confirmedOnly ? barstate.isconfirmed : true
// 1. System Toggles
bool enableFVG          = input.bool(true, "Enable FVG", group=grp_master)
bool enableRPD          = input.bool(true, "Enable RPD", group=grp_master)
bool enableHybridSMC    = input.bool(true, "Enable SMC", group=grp_master)
bool enableRegOB        = input.bool(true, "Enable REG", group=grp_master)
bool enableLiquidity    = input.bool(true, "Enable LIQ", group=grp_master)

// 2. Global Aesthetics & Calibration
string masterTheme      = input.string("Institutional", "Master Theme", options=["Institutional", "Modern Mint", "Deep Sea", "Monochrome", "Neon Cyber"], group=grp_master)
bool   isDarkChart      = input.bool(true, "Dark Theme Canvas", group=grp_master, tooltip="Toggle between Dark and Light chart backgrounds. Automatically adjusts text contrast, borders, and table readability.")
string visualPreset     = input.string("Minimalist (Clean)", "Visual Density Preset", options=["Minimalist (Clean)", "Balanced Institutional", "Order Flow Focus", "Full Forensic"], group=grp_master, tooltip="One-click visual density preset:\n• Minimalist (Clean — XAUUSD Micro default, SPEC WP-D2): Hides decorative elements so REG stays the structure/context layer and OSC owns the single 'DO THIS NOW' decision.\n• Balanced Institutional: All active structural zones, high-percentile Order Flow bubbles, RPD calibrated signals, and key levels.\n• Order Flow Focus: Highlights Intrabar Footprint Delta, CVD Divergence diamonds, and Volume POC.\n• Full Forensic: Complete diagnostic view including all historical boxes, gap taxonomy, and Fibonacci bands.")
int globalAtrLength     = input.int(14, "Universal ATR Length", minval=1, group=grp_master, tooltip="Used for all dynamic volatility calculations")
int regLength           = input.int(100, "Regression Channel Length", minval = 1, maxval = 5000, group=grp_master, tooltip="Period for Linear Regression Channel Calculation (Trend)")

// 3. Signal Logic & Optimization
bool optimizeForScalping = input.bool(true, "⚡ Optimize for Gold Scalping", group=grp_master, tooltip="Aggressively removes mitigated zones, simplifies labels, and prioritizes recent price action. ON for the XAUUSD Micro preset (SPEC WP-D2) so REG stops competing with OSC for pixels.")
string signalPriority   = input.string("Show All", "Signal Priority", options=["Show All", "A+ Only", "A and A+ Only"], group=grp_master)

// 4. Integrated Filtering
bool useRPDasFilter     = input.bool(false, "Use RPD to Filter FVG Setups", group=grp_master, tooltip="Only show FVG setups when RPD confirms a reversal")
float rpdFilterMinProb  = input.float(60, "RPD Filter Min Probability", minval=50, maxval=95, group=grp_master, tooltip="Minimum RPD probability to validate FVG setups")

// 5. Phase 2 — Measurement Layer (signal ledger & calibration)
string grp_ledger       = "📐 Signal Ledger & Calibration"
int    evalHorizon      = input.int(20, "Evaluation Horizon (bars)", minval=2, maxval=200, group=grp_ledger, tooltip="Bars over which MFE/MAE and R-multiple are resolved for each signal.")
int    rollingWindow    = input.int(50, "Calibration Window (signals)", minval=5, maxval=500, group=grp_ledger, tooltip="Rolling sample size used to compute empirical win rate per signal type.")
float  syntheticR_atr   = input.float(1.0, "Synthetic 1R (x ATR)", minval=0.1, step=0.1, group=grp_ledger, tooltip="Risk unit used when a signal has no explicit stop (exhaustion / RPD). 1R = this * ATR.")
bool   useCalibratedProb = input.bool(true, "Use Rolling Hit Estimate", group=grp_ledger, tooltip="Replace the heuristic RPD score with a Beta-smoothed rolling empirical hit estimate after the minimum sample count is reached. This is descriptive in-sample monitoring, not forecast calibration.")
int    ledgerTypeCount   = input.int(18, "Tracked Signal Types", minval=1, maxval=40, group=grp_ledger, tooltip="Used only to size the ledger cap (cap = window x types). Raise if you add signal types.")
float  minRiskAtr        = input.float(0.25, "Min Risk Floor (x ATR)", minval=0.0, step=0.05, group=grp_ledger, tooltip="Floor on the 1R distance used by the ledger. Several signal types stop at the current bar's own extreme (exhaustion stops at `high`, a bear sweep stops at the sweep `high`). When the bar closes near that extreme the implied 1R collapses to a few ticks, the next bar trivially takes it out, and the record resolves -1R regardless of what price actually did. That is not a losing signal, it is an unmeasurable one. This floor makes R comparable across signal types.")
int    riskBufferTicks   = input.int(0, "Stop Buffer (ticks)", minval=0, group=grp_ledger, tooltip="Extra ticks added beyond the stated stop before the ledger counts it as touched, covering spread/slippage. XAUUSD spot spreads run 10-40 ticks depending on session, so 10-20 is realistic there. 0 = measure the raw level.")
// SPEC WP-C3/C2 — friction honesty & sample-size gating (XAUUSD Micro preset).
int    spreadCostTicks   = input.int(25, "Round-Trip Spread Cost (ticks)", minval=0, group=grp_ledger, tooltip="Subtracted from every ledger resolution so expectancy is NET. Typical retail XAUUSD spot spread is 15-35 ticks.")
float  accountEquityL    = input.float(100.0, "Account Equity ($)", minval=1.0, step=10.0, group=grp_ledger, tooltip="Used only to normalize commission into R-multiples.")
float  riskPctL          = input.float(1.0, "Risk per Signal (%)", minval=0.1, maxval=10.0, step=0.1, group=grp_ledger, tooltip="1% of $100 = $1.00 risk.")
float  commissionPerTrade = input.float(0.00, "Commission per Trade ($)", minval=0.0, step=0.01, group=grp_ledger, tooltip="Dollar commission for one 0.01-lot round trip; subtracted from every ledger resolution.")
int    minCalSamples     = input.int(15, "Min Samples for Calibrated %", minval=1, maxval=200, group=grp_ledger, tooltip="Until a signal type has this many closed records the empirical win rate renders GRAY + '(warmup)' — a Beta(2,2)-smoothed rate on n<15 is noise, not an edge (SPEC WP-C2, fix F8).")

// 6. Phase 2 — Clutter control (distance culling & dedupe)
string grp_clutter      = "🧹 Clutter Control"
bool   cullFarZones     = input.bool(true, "Cull Far Zones", group=grp_clutter, tooltip="Delete liquidity zones and Reg OBs further than the distance below. A level 40 ATRs away is not tradeable context, it is clutter that also burns the drawing budget.")
float  maxZoneDistAtr   = input.float(20.0, "Max Zone Distance (x ATR)", minval=2.0, step=1.0, group=grp_clutter)
float  regDedupeAtr     = input.float(0.25, "Reg OB Dedupe Tolerance (x ATR)", minval=0.0, step=0.05, group=grp_clutter, tooltip="Consecutive bars in a directional run all qualify as OB sources and stack near-identical zones on one level. A new OB within this distance of the last one in the same direction is suppressed.")


// UNIFIED COLOR LOGIC
// Returns [Bull, Bear, Neutral, Accent]
f_getThemePalette(string theme) =>
    color c_bull = #00B4D8
    color c_bear = #FF3B30
    color c_neut = color.gray
    color c_acc  = #FFD700
    
    if theme == "Institutional"
        c_bull := #00B4D8 // Vivid Blue
        c_bear := #FF3B30 // Vivid Red
        c_neut := #787B86
        c_acc  := #FFD700 // Gold
    else if theme == "Modern Mint"
        c_bull := #00E676 // Bright Mint
        c_bear := #FF1744 // Deep Pink/Red
        c_neut := #B2DFDB
        c_acc  := #651FFF // Deep Purple
    else if theme == "Deep Sea"
        c_bull := #00BCD4 // Cyan
        c_bear := #FF5252 // Coral Red
        c_neut := #546E7A // Blue Grey
        c_acc  := #00E5FF // Cyan Accent
    else if theme == "Monochrome"
        c_bull := #B0B0B0 // Medium Grey (Visible text)
        c_bear := #505050 // Dark Grey
        c_neut := #909090
        c_acc  := #FFFFFF
    else if theme == "Neon Cyber"
        c_bull := #00FF00 // Lime
        c_bear := #FF0055 // Neon Red
        c_neut := #2b303b
        c_acc  := #F000FF // Magenta
        
    [c_bull, c_bear, c_neut, c_acc]

// Fetch Master Colors
[u_bull, u_bear, u_neut, u_acc] = f_getThemePalette(masterTheme)

// Semantic Contrast Tokens (Theme Adaptive)
color c_text_primary   = isDarkChart ? #E0E3EB : #131722
color c_text_secondary = isDarkChart ? #787B86 : #50535E
color c_text_muted     = isDarkChart ? color.new(#787B86, 40) : color.new(#50535E, 40)
color c_table_bg       = isDarkChart ? #131722 : #FFFFFF
color c_table_border   = isDarkChart ? #2A2E39 : #D1D4DC
color c_table_header   = isDarkChart ? #1E222D : #F0F3FA
color c_table_section  = isDarkChart ? #262B38 : #E8ECF5
color c_table_row_alt  = isDarkChart ? #181C27 : #F8F9FD

// Visual Density Preset States
bool isPresetMinimal   = visualPreset == "Minimalist (Clean)"
bool isPresetOF        = visualPreset == "Order Flow Focus"




// TYPES (FVG System)


type Swing
    float price
    int index
    bool isHigh 

// Helper Function for Size
// (f_getSizeLiq removed — it duplicated f_get_size() below and had no fallback
//  branch, so an unmatched string returned na.)

type CandleRange
    float top
    float bottom
    int index
    bool isBullish 

type FVG
    float top
    float bottom
    int index
    bool isBullish
    bool isMitigated

type UnicornSetup
    int id
    bool isBullish
    CandleRange breaker 
    FVG fvg             
    float entryPrice    
    float stopPrice     
    box breakerBox      
    box fvgBox          
    line stopLine
    label infoLabel     
    bool isActive
    int barsActive
    string timeframe
    int confluenceCount
    label confluenceLabel


// HYBRID SMC TYPES


type SwingPoint
    float price
    int   index

type MarketStructure
    float lastHighPrice
    int   lastHighIndex
    float lastLowPrice
    int   lastLowIndex
    int   trendDir
    int   trendStartBar

type OrderBlock
    box   id
    float top
    float bottom
    bool  isBullish


// LIQUIDITY ZONE TYPES


type LiquidityLevel
    float price
    int   createdBar
    bool  active = true
    box   bx
    line  liqLine
    int   lastSweepBar = -999


// REGRESSION OB TYPES


type RegOB
    line highLine
    line lowLine
    int startIndex
    bool isBull
    bool active
    int confirmCount
    bool isConfirmed
    box zoneBox


// PHASE 2 — SIGNAL LEDGER TYPE
// One row per confirmed signal. Tracks MFE/MAE over an evaluation horizon and
// resolves to an R-multiple outcome vs. the signal's own stated stop.
type SignalRecord
    string sigType        // e.g. "RPD_Peak","RPD_Valley","FVG_Bull","FVG_Bear","LIQ_Bear","LIQ_Bull","EXH_Buy","EXH_Sell","RegOB_Bull","RegOB_Bear"
    int    entryBar
    float  entryPrice
    int    direction      //  1 = long, -1 = short
    float  stopPrice
    float  stopTrigger    // executable trigger including adverse stop buffer
    float  riskPerUnit    // |entry - structural stop|; never enlarged by execution buffer
    int    horizon        // bars to evaluate
    int    barsElapsed
    float  mfePrice       // best favorable excursion in price
    float  maePrice       // worst adverse excursion in price
    float  rMultiple      // resolved outcome in R, NET of spread+commission (set on close)
    float  rMultipleGross // same resolution BEFORE friction — kept for gross-vs-net review
    bool   closed
    bool   win
    bool   stopped        // true if stop was touched before horizon



// FVG INPUTS


grp_mtf = "Multi-Timeframe Settings (FVG)"
bool enableMTF = input.bool(true, "Enable Multi-Timeframe", group=grp_mtf, tooltip="Pull setups from all higher timeframes and display on current chart")
bool showCurrent = input.bool(true, "Show Current Timeframe", group=grp_mtf, inline="tf0")
bool show3min = input.bool(false, "Show 3 Min", group=grp_mtf, inline="tf1", tooltip="Off by default: sub-chart timeframes are fetched with request.security(), which returns only the last completed value inside the current bar. Detections there are under-sampled and are excluded from the calibration ledger.")
bool show5min = input.bool(false, "Show 5 Min", group=grp_mtf, inline="tf2", tooltip="See 3 Min tooltip. Off by default on any chart above 5m.")
bool show15min = input.bool(true, "Show 15 Min", group=grp_mtf, inline="tf3")
bool show30min = input.bool(true, "Show 30 Min", group=grp_mtf, inline="tf4")
bool show1hour = input.bool(true, "Show 1 Hour", group=grp_mtf, inline="tf5")
bool show2hour = input.bool(true, "Show 2 Hour", group=grp_mtf, inline="tf6")
bool show4hour = input.bool(true, "Show 4 Hour", group=grp_mtf, inline="tf7")
bool showDaily = input.bool(true, "Show Daily", group=grp_mtf, inline="tf8")
bool showWeekly = input.bool(false, "Show Weekly", group=grp_mtf, inline="tf9")
bool showConfluence = input.bool(true, "Show Confluence Indicator", group=grp_mtf, tooltip="Highlight setups when multiple timeframes align")
int minConfluenceTFs = input.int(2, "Min Timeframes for Confluence", minval=2, maxval=5, group=grp_mtf, tooltip="Minimum number of timeframes needed to show confluence")

grp_sets = "FVG Settings"
int swingLength = input.int(5, "Swing Length", minval=3, maxval=20, group=grp_sets, tooltip="Number of bars to left/right for pivot detection")
float fvgThreshold = input.float(0.2, "FVG Min Size (x ATR)", minval=0.05, step=0.05, group=grp_sets, tooltip="Minimum size of the gap relative to ATR. Keep this low: on gold the real 15m gap distribution clusters around 0.2-0.4x ATR, so the old 0.5 default rejected almost every genuine imbalance (including unfilled 4H gaps).")
bool  fvgAdaptThresh = input.bool(true, "Adapt Threshold to Volatility Regime", group=grp_sets, tooltip="ATR scaling alone does not make the threshold regime-neutral: in a compressed tape (Asian gold, holiday sessions) ATR shrinks toward the spread/tick floor, so a fixed ATR multiple starts admitting gaps that are pure microstructure noise. When current ATR falls below 0.85x its own 50-bar baseline the threshold is scaled up (1.30x), below 0.70x it is scaled up further (1.75x). No clock or timezone is involved, so this works on any broker feed and any instrument.")
int   fvgMinTicks    = input.int(0, "FVG Min Size (tick floor)", minval=0, group=grp_sets, tooltip="Hard floor in ticks, applied on top of the ATR test. A gap smaller than a couple of spreads is not tradeable regardless of what ATR says. 0 = off. For XAUUSD spot, 20-40 ticks ($0.20-$0.40) is a reasonable floor.")
int minBarsBetween = input.int(10, "Min Bars Between Setups", minval=1, maxval=100, group=grp_sets, tooltip="Minimum bars required between new setups of same type")
string invalidationMode = input.string("Close", "Invalidation Basis", options=["Close", "Wick"], group=grp_sets, tooltip="Determines if a setup is invalidated by a candle Close or Wick crossing the stop level")
bool deleteInvalid = input.bool(false, "Delete Invalidated Setups", group=grp_sets, tooltip="Removes drawings if the setup fails")
int maxActiveSetups = input.int(10, "Max Active Setups Per Timeframe", minval=1, maxval=50, group=grp_sets, tooltip="Maximum number of active setups per timeframe")
int maxBarsActive = input.int(500, "Max Bars Active", minval=10, maxval=500, group=grp_sets, tooltip="Auto-remove setups after this many bars")
bool showStopLine = input.bool(true, "Show Stop Loss Line", group=grp_sets)
bool autoExtendBoxes = input.bool(true, "Auto-Extend Boxes", group=grp_sets, tooltip="Keep extending boxes right edge (can cause clutter)")

grp_filter = "FVG Quality Filters"
bool enableFilters = input.bool(true, "Enable Quality Filters", group=grp_filter)
float minRiskReward = input.float(1.5, "Min Risk/Reward Ratio", minval=0.5, maxval=10, step=0.5, group=grp_filter, tooltip="Minimum R:R ratio - filters weak setups")
bool filterTrendAlignment = input.bool(true, "Filter Against Trend", group=grp_filter, tooltip="Reject setups trading against short-term trend")
int trendLength = input.int(20, "Trend EMA Length", minval=5, maxval=200, group=grp_filter, tooltip="EMA period for trend detection")
bool filterVolatility = input.bool(true, "Filter Low Volatility", group=grp_filter, tooltip="Reject setups during low volatility periods")
float minVolatility = input.float(0.5, "Min Volatility (ATR Ratio)", minval=0.1, maxval=2, step=0.1, group=grp_filter, tooltip="Minimum ATR compared to average")
bool filterPriceAction = input.bool(true, "Filter Weak Candles", group=grp_filter, tooltip="Reject setups with weak breakout candles")
float minCandleSize = input.float(0.3, "Min Candle Size (ATR)", minval=0.1, maxval=2, step=0.1, group=grp_filter, tooltip="Minimum breakout candle size")

grp_vis_fvg = "FVG Visuals"

// FVG Visuals (Restored)
int boxTransparency = input.int(90, "Box Transparency", minval=0, maxval=100, group=grp_vis_fvg)
int borderTransparency = input.int(20, "Border Transparency", minval=0, maxval=100, group=grp_vis_fvg)
bool showGradient = input.bool(true, "Use Gradient Effect", group=grp_vis_fvg)
bool compactLabels = input.bool(true, "Compact Labels", group=grp_vis_fvg)
