// SHARED VARIABLES


// Consolidated ATR (recomputed every bar; `var` here was a no-op)
float atr = ta.atr(globalAtrLength)


// PHASE 2 — SIGNAL LEDGER GLOBAL STATE
var array<SignalRecord> ledger = array.new<SignalRecord>()
var array<SignalRecord> openLedger = array.new<SignalRecord>()

// Record a new confirmed signal into the ledger.
// Two corrections applied before the record is stored, both of which the measurement
// layer depends on:
//   1. Wrong-side stops. Callers pass a level that is *usually* on the protective side
//      (RegOB_Bull stops at the zone floor, EXH_Buy at the bar high). Nothing enforces
//      it. A long whose stop sits above entry is marked stopped on the very next bar and
//      books -1R without price having done anything — a silent negative bias on exactly
//      the signal types whose zones price has already traded into.
//   2. Degenerate risk. Stops taken from the current bar's own extreme collapse to a few
//      ticks when the bar closes near that extreme, so 1R becomes noise-sized and every
//      such record resolves -1R. Floor it.
f_ledgerRecord(string sigType, float entryPrice, int direction, float stopPrice) =>
    float rFloor = atr * minRiskAtr
    float stop = stopPrice
    // Wrong-side stops are invalid signal geometry. Do not silently convert them into
    // synthetic ATR trades because that mixes a different strategy into this cohort.
    bool wrongSide = not na(stop) and (direction == 1 ? stop >= entryPrice : stop <= entryPrice)
    float r = wrongSide or na(stop) ? float(na) : math.abs(entryPrice - stop)
    if not wrongSide
        // Missing stops may still use the explicitly configured synthetic-risk model.
        if na(r) or r <= 0
            r := math.max(atr * syntheticR_atr, rFloor)
            stop := direction == 1 ? entryPrice - r : entryPrice + r
        if r < rFloor
            // Stop is on the right side but too tight to measure; push it out to the floor.
            r := rFloor
            stop := direction == 1 ? entryPrice - r : entryPrice + r
        // Keep structural 1R fixed. The buffer only changes the executable stop trigger,
        // so increasing an adverse execution assumption cannot shrink friction in R.
        float stopTrigger = direction == 1 ? stop - syminfo.mintick * riskBufferTicks : stop + syminfo.mintick * riskBufferTicks
        SignalRecord rec = SignalRecord.new(sigType, bar_index, entryPrice, direction, stop, stopTrigger, r, evalHorizon, 0, 0.0, 0.0, 0.0, 0.0, false, false, false)
        array.push(ledger, rec)
        array.push(openLedger, rec)
    float(na)

// Advance open records: update MFE/MAE, resolve on stop-touch or horizon end.
// O(1) open records list avoids scanning hundreds of historical closed records every bar.
f_ledgerUpdate() =>
    if array.size(openLedger) > 0
        for i = array.size(openLedger) - 1 to 0
            SignalRecord rec = array.get(openLedger, i)
            rec.barsElapsed += 1
            // Favorable / adverse excursion in price (this bar's extremes vs entry).
            float fav = rec.direction == 1 ? high - rec.entryPrice : rec.entryPrice - low
            float adv = rec.direction == 1 ? rec.entryPrice - low : high - rec.entryPrice
            if fav > rec.mfePrice
                rec.mfePrice := fav
            if adv > rec.maePrice
                rec.maePrice := adv
            // WP-C3: friction in R per resolution — spread vs this record's own 1R,
            // commission normalized by the $ risk. Winners and losers both pay it.
            float frR = spreadCostTicks * syminfo.mintick / math.max(rec.riskPerUnit, syminfo.mintick) + (accountEquityL * riskPctL > 0 ? commissionPerTrade / (accountEquityL * riskPctL / 100.0) : 0.0)
            // Stop touch (adverse >= 1R) resolves as a stopped loss immediately.
            bool stopTouched = rec.direction == 1 ? low <= rec.stopTrigger : high >= rec.stopTrigger
            if stopTouched
                rec.stopped := true
                rec.closed  := true
                rec.rMultiple      := -1.0 - frR
                rec.rMultipleGross := -1.0
                rec.win      := false
                array.remove(openLedger, i)
            else if rec.barsElapsed >= rec.horizon
                // Resolve at horizon: R-multiple = directional PnL / risk.
                float pnl = rec.direction == 1 ? close - rec.entryPrice : rec.entryPrice - close
                rec.rMultipleGross := pnl / rec.riskPerUnit
                rec.rMultiple      := rec.rMultipleGross - frR
                rec.win       := rec.rMultiple > 0
                rec.closed    := true
                array.remove(openLedger, i)

// Rolling empirical win rate + sample size for a signal type, in one pass.
// Beta-prior(2,2) smoothing so cold-start isn't 0% or 100%.
f_calStats(string sigType) =>
    int wins = 0
    int total = 0
    if array.size(ledger) > 0
        // Iterate from most recent backwards over the rolling window.
        for i = array.size(ledger) - 1 to 0
            if total >= rollingWindow
                break
            SignalRecord rec = array.get(ledger, i)
            if rec.sigType == sigType and rec.closed
                total += 1
                if rec.win
                    wins += 1
    // Beta(2,2) prior → (wins+2)/(total+4)
    [(float(wins) + 2.0) / (float(total) + 4.0) * 100.0, total]

// Beta-smoothed rolling empirical hit estimate for a given signal type.
f_calibratedProb(string sigType) =>
    [p, n] = f_calStats(sigType)
    n >= minCalSamples ? p : na

// Realized expectancy (in R) for a given signal type, NET of spread+commission (WP-C3).
f_expectancyR(string sigType) =>
    float sumR = 0.0
    int total = 0
    if array.size(ledger) > 0
        for i = array.size(ledger) - 1 to 0
            SignalRecord rec = array.get(ledger, i)
            if rec.sigType == sigType and rec.closed
                sumR += rec.rMultiple
                total += 1
                if total >= rollingWindow
                    break
    total > 0 ? sumR / float(total) : na

// Same, gross — for the net-vs-gross comparison the SPEC validation pass requires.
f_expectancyRGross(string sigType) =>
    float sumR = 0.0
    int total = 0
    if array.size(ledger) > 0
        for i = array.size(ledger) - 1 to 0
            SignalRecord rec = array.get(ledger, i)
            if rec.sigType == sigType and rec.closed
                sumR += rec.rMultipleGross
                total += 1
                if total >= rollingWindow
                    break
    total > 0 ? sumR / float(total) : na

// Keep the ledger bounded. Records resolve deterministically within evalHorizon bars
// (stop touch or horizon end), so the oldest entry is normally closed once we are past
// the horizon — dropping from the front never discards an unresolved signal. The
// force-drop branch is a backstop, not the main path: it only fires for a record that
// is over cap AND has outlived twice its own horizon, which can only happen if the
// horizon was raised mid-run or a record was created with a stale horizon.
f_ledgerPrune() =>
    int cap = rollingWindow * ledgerTypeCount
    while array.size(ledger) > cap
        SignalRecord oldest = array.get(ledger, 0)
        if oldest.closed or (bar_index - oldest.entryBar) > oldest.horizon * 2
            SignalRecord dropped = array.shift(ledger)
            float(na)
        else
            break
    float(na)

// Ledger time is always chart-bar time. Signal detection may run intrabar, but an
// evaluation horizon must never advance once per tick on the realtime bar.
bool ledgerBarAdvance = barstate.isconfirmed
if ledgerBarAdvance
    f_ledgerUpdate()
    f_ledgerPrune()


// PHASE 2 — DISPLAY PROBABILITY (single source of truth)
// The chart and the dashboard must never show two different confidence numbers for
// the same signal. When calibrated mode is on, everything user-facing reads the
// measured win rate; the heuristic score stays in the tooltip for comparison.
//
// NOTE: signal *detection* still gates on the heuristic (validPeak / validValley).
// That is deliberate — the ledger only learns from signals that actually fire, so
// suppressing detection on a cold empirical rate would starve the calibration loop.
f_displayProb(string sigType, float heuristicProb) =>
    [rollingHit, rollingN] = f_calStats(sigType)
    na(heuristicProb) ? na : (useCalibratedProb ? (rollingN >= minCalSamples ? rollingHit : na) : heuristicProb)

// Display tiers. The two bases live on different scales: the heuristic is clamped to
// [40,99] and reads "high" at 75-80, whereas an empirical win rate is measured against
// a ~50% breakeven (1R stop, horizon exit). Using 75/80 cutoffs on a win rate would
// fade out every label permanently, so the tiers switch with the basis.
float tierHigh = useCalibratedProb ? 60.0 : 80.0
float tierMid  = useCalibratedProb ? 52.0 : 60.0
float tierShow = useCalibratedProb ? 50.0 : 75.0
float tierFade = useCalibratedProb ? 50.0 : 70.0


// PHASE 2 OPTIMIZATION HELPERS


// 1. Scoring Engine
// Components are weighted to sum to exactly 100 (30 + 25 + 20 + 25). The old version
// summed to 90, which made the "A+ Only" threshold of 80 require near-perfect
// confluence and left the top of the scale unreachable.
calcSignalScore(bool isTrendAligned, float rpdProb, int confluenceCount, bool liqSweep) =>
    int score = 0
    // Trend Alignment (Highest Weight)
    if isTrendAligned
        score += 30

    // Probability tier — cutoffs follow whichever basis is active (see tierHigh above)
    // so an A+ is reachable under empirical scoring, not just under the heuristic.
    if not na(rpdProb)
        if rpdProb >= tierHigh
            score += 25
        else if rpdProb >= tierMid
            score += 15
        else if rpdProb >= tierShow
            score += 5

    // Confluence (FVG MTF)
    if confluenceCount >= 3
        score += 20
    else if confluenceCount >= 2
        score += 12

    // Liquidity Sweep Context
    if liqSweep
        score += 25

    // Cap at 100
    math.min(100, score)

// 2. Context-Based Rendering
// Only returns true if the level is within 'n' ATRs of the current price
isVisible(float level, float n) =>
    float dist = math.abs(close - level)
    float visRange = atr * n
    dist <= visRange

// 3. Volatility-regime multiplier for the FVG size gate.
// `regime` is current ATR / its own longer baseline on the SAME timeframe, so this is
// applied identically on the chart TF and inside each MTF request without importing the
// chart's volatility into a higher timeframe's decision.
f_fvgRegimeMult(float regime) =>
    not fvgAdaptThresh or na(regime) ? 1.0 : regime < 0.70 ? 1.75 : regime < 0.85 ? 1.30 : 1.0


