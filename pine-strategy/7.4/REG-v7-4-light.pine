// Regression OB Inputs (Unified - Moved to Top)
// Colors handled by Unified Theme (Global definitions assumed existing)
// Colors handled by Unified Theme

// --- Group: Market Structure ---
string GRP_STRUC    = "🏗️ SMC: Market Structure Logic"
string GRP_S_VIS    = "🎨 SMC: Market Structure Visuals"
int    inSwingLen   = input.int(5, "Swing Detection Length", minval=2, group=GRP_STRUC)
bool   inShowChoch  = input.bool(true, "Show CHoCH", group=GRP_STRUC)
