// Trend detection
float trendEMA = ta.ema(close, trendLength)
bool isUptrend = close > trendEMA
bool isDowntrend = close < trendEMA

// Volatility filter
float atrAvg = ta.sma(atr, 20)
float volatilityRatio = atr / atrAvg
bool isHighVolatility = volatilityRatio > minVolatility


// RPD HELPER FUNCTIONS


f_get_size(s) =>
    if s == "Tiny"
        size.tiny
    else if s == "Small"
        size.small
    else if s == "Normal"
        size.normal
    else if s == "Large"
        size.large
    else
        size.normal

getSupertrend(_src, _mult, _len) =>
    atr_rpd = ta.atr(_len)
    upper = _src - _mult * atr_rpd
    lower = _src + _mult * atr_rpd
    upper := close[1] > upper[1] ? math.max(upper, upper[1]) : upper
    lower := close[1] < lower[1] ? math.min(lower, lower[1]) : lower
    var int trend = 1
    trend := trend == -1 and close > lower[1] ? 1 : trend == 1 and close < upper[1] ? -1 : trend
    [trend, upper, lower]

[rTrend, _, _] = getSupertrend(hlcc4, 1.1, 16)


// --- DEDUPLICATION HELPERS ---

// Helper for Liquidity Zones
f_createLiqZone(float price, int idx, bool isBear) =>
    float bodyTop = math.max(open[pivotLenLiq], close[pivotLenLiq])
    float bodyBot = math.min(open[pivotLenLiq], close[pivotLenLiq])
    // box.new() takes (top, bottom) with top >= bottom. The old code passed the body
    // edge as `top` and the pivot as `bottom` on the bear side (and the reverse on the
    // bull side), i.e. both were inverted. The band drawn is the same sweep wick —
    // from the pivot extreme back to the candle body — just correctly ordered now.
    float boxTop = isBear ? price   : bodyBot
    float boxBot = isBear ? bodyTop : price
    
    // Psychological round-level tag. Annotation only — detection and scoring are untouched.
    // Drives line weight only (2px vs 1px) now that the zone carries no labels.
    float psychLevel = liqPsychStep > 0 ? math.round(price / liqPsychStep) * liqPsychStep : na
    bool  isPsych    = not na(psychLevel) and math.abs(price - psychLevel) <= math.max(atrValLiq * 0.10, syminfo.mintick)

    box b = box.new(idx, boxTop, bar_index, boxBot, bgcolor=color.new(isBear ? bearZoneBg : bullZoneBg, liqZoneTrans), border_color=na)
    line hL = line.new(idx, price, bar_index, price, color=showLIQLine ? liqLineCol : na, width=isPsych ? 2 : 1, style=line.style_solid)

    LiquidityLevel.new(price, idx, true, b, hL, -999)

// Helper for Regression Order Blocks (zero-delay aware)
f_processRegOB(bool isBull, int bIdx, float top, float bot, float szPct, float impPct, color col, int confirms, bool confirmed) =>
    int extBars = regExtendLines ? regObRightOffset : 0
    bool isPending = not confirmed and regShowPending
    color lineCol = col
    string lineStyle = isPending ? line.style_dashed : line.style_solid
    int lineW = 1

    // Draw Lines (No border)
    l1 = line.new(bIdx, top, bar_index + extBars, top, color=na, width=lineW, style=lineStyle)
    l2 = line.new(bIdx, bot, bar_index + extBars, bot, color=na, width=lineW, style=lineStyle)

    // Zone Box (No border)
    int boxTrans = isPending ? 92 : 90
    box zBox = box.new(bIdx, top, bar_index + extBars, bot,
         bgcolor=color.new(col, boxTrans),
         border_color=na, border_width=0)

    // Store and Return
    RegOB.new(l1, l2, bIdx, isBull, true, confirms, confirmed, zBox)

// Pre-checks for OB source candle (shared by zero-delay + legacy modes)
// Uses bar[1] in zero-delay mode (caller handles offset)
f_regObSizeCheck(bool isBull, int srcOffset) =>
    float obSize = 0.0
    if isBull
        float h = regUseWicks ? high[srcOffset] : open[srcOffset]
        float l = regUseWicks ? low[srcOffset]  : math.min(open[srcOffset], close[srcOffset])
        obSize := na(h) or na(l) or l <= 0 ? na : (h - l) / l * 100
    else
        float h = regUseWicks ? high[srcOffset] : math.max(open[srcOffset], close[srcOffset])
        float l = regUseWicks ? low[srcOffset]  : open[srcOffset]
        obSize := na(h) or na(l) or l <= 0 ? na : (h - l) / l * 100
    // Explicit na guard: at bar 0 the [1] offset is na, and an unguarded na propagates
    // into the boolean as an indeterminate rather than a clean reject.
    bool sizeOK = not na(obSize) and obSize >= regMinObSize and obSize <= regMaxObSize
    bool atrOK = not regUseAtrFilter or ((high[srcOffset] - low[srcOffset]) <= atrValLiq[srcOffset] * regAtrMult)
    [sizeOK and atrOK, nz(obSize)]


// HYBRID SMC METHODS


draw_choch_label(int idx, float price, bool isBull, color c) =>
    if inRangeCache and not na(idx)
        string tip = "CHANGE OF CHARACTER (CHoCH)\n• Signal: " + (isBull ? "Bullish Reversal" : "Bearish Reversal") + "\n\nConcept: Price broke significant structure (" + (isBull ? "High" : "Low") + ").\nStrategy: Wait for retrace to Order Block."
        label.new(idx, price, "CHoCH", xloc=xloc.bar_index, 
             style = isBull ? label.style_label_down : label.style_label_up, 
             color=color.new(color.white, 100), textcolor=c, size=size.small, tooltip=tip)

draw_choch_line(int x1, float y1, int x2, float y2, color c) =>
    if inRangeCache and not na(x1)
        line.new(x1, y1, x2, y2, color=c, style=line.style_dashed)

method findOrderBlock(MarketStructure state, bool isBull) =>
    int breakIndex = isBull ? state.lastHighIndex : state.lastLowIndex
    
    if not na(breakIndex)
        int lookback = math.min(bar_index - breakIndex, 50) 
        
        if lookback > 1
            int extremeIdx = bar_index
            
            if isBull
                float lowest = low
                for i = 1 to lookback
                    if low[i] < lowest
                        lowest := low[i]
                        extremeIdx := bar_index - i
            else
                float highest = high
                for i = 1 to lookback
                    if high[i] > highest
                        highest := high[i]
                        extremeIdx := bar_index - i
            
            int offset = bar_index - extremeIdx
            int finalOffset = offset
            
            int searchLimit = math.min(5, lookback - offset)
            for j = 0 to searchLimit
                int idx = offset + j
                if idx < bar_index
                    bool isTargetCandle = isBull ? (close[idx] < open[idx]) : (close[idx] > open[idx])
                    if isTargetCandle
                        finalOffset := idx
                        break
            
            if inRangeCache
                float obTop    = high[finalOffset]
                float obBottom = low[finalOffset]
                int   obLeft   = bar_index - finalOffset
                color bg = isBull ? colBullOb : colBearOb

                box b = box.new(obLeft, obTop, bar_index + regObRightOffset, obBottom,
                     border_color=na, bgcolor=color.new(bg, obTransparency), xloc=xloc.bar_index)

                array.push(activeOrderBlocks, OrderBlock.new(b, obTop, obBottom, isBull))

method analyzeGap(MarketStructure state, float volAvg, float volMult, int maturityThresh, float minGap) =>
    bool isValid = false
    bool isBullish = false
    float top = na
    float bottom = na
    string gapType = "Standard"
    
    if bar_index >= 2
        bool bullGap = low > high[2] and close[1] > open[1]
        bool bearGap = high < low[2] and close[1] < open[1]

        if bullGap
            float size = low - high[2]
            if size >= minGap
                isValid := true
                isBullish := true
                top := low
                bottom := high[2]
                
                bool isBreakout = not na(state.lastHighPrice) and 
                                  close[1] > state.lastHighPrice and 
                                  close[2] <= state.lastHighPrice
                
                bool isHighVol = volume[1] > (volAvg * volMult)
                bool isExtended = (bar_index - state.trendStartBar) > maturityThresh
                
                gapType := isBreakout ? "Breakaway" : 
                          (isHighVol and isExtended ? "Exhaustion" : "Runaway")
                          
        else if bearGap
            float size = low[2] - high
            if size >= minGap
                isValid := true
                isBullish := false
                top := low[2]
                bottom := high
                
                bool isBreakout = not na(state.lastLowPrice) and 
                                  close[1] < state.lastLowPrice and 
                                  close[2] >= state.lastLowPrice
                
                bool isHighVol = volume[1] > (volAvg * volMult)
                bool isExtended = (bar_index - state.trendStartBar) > maturityThresh
                
                gapType := isBreakout ? "Breakaway" : 
                          (isHighVol and isExtended ? "Exhaustion" : "Runaway")
    
    [isValid, isBullish, top, bottom, gapType]

calc_stress(int len, float threshold) =>
    float volSafe = math.max(volume, 1.0)  
    float impact = ta.tr(true) / volSafe
    float raw = math.log(impact + 1)
    float mean = ta.sma(raw, len)
    float std = ta.stdev(raw, len)
    float z = std == 0 ? 0.0 : (raw - mean) / std
    z > threshold


// REGRESSION HELPERS


// O(1) linear-regression slope/average/intercept via SMA/WMA closed forms.
// x = 1..n (oldest..newest), matching ta.wma weighting. Returns [slope, average, intercept@x=1].
calcSlope(source, length) =>
    if length <= 1
        [float(na), float(na), float(na)]
    else
        n   = float(length)
        sx  = n * (n + 1.0) * 0.5
        sy  = ta.sma(source, length) * n
        sx2 = n * (n + 1.0) * (2.0 * n + 1.0) / 6.0
        sxy = ta.wma(source, length) * sx
        denom = n * sx2 - sx * sx
        slope_     = denom != 0 ? (n * sxy - sx * sy) / denom : 0.0
        average_   = sy / n
        intercept_ = average_ - slope_ * sx / n + slope_
        [slope_, average_, intercept_]

calcRegStats(source, length) =>
    // O(1) optimized statistics for Regression
    n = float(length)
    sumX_ = n * (n + 1.0) * 0.5
    sumY_ = ta.sma(source, length) * n
    sumXSqr_ = n * (n + 1.0) * (2.0 * n + 1.0) / 6.0
    sumXY_ = ta.wma(source, length) * sumX_
    sumYSqr_ = ta.sma(source * source, length) * n
    
    numerator = n * sumXY_ - sumX_ * sumY_
    denomX = n * sumXSqr_ - sumX_ * sumX_
    denomY = n * sumYSqr_ - sumY_ * sumY_
    pearson = (denomX > 0 and denomY > 0) ? numerator / math.sqrt(denomX * denomY) : 0
    stdevY = ta.stdev(source, length)
    stdDev = stdevY * math.sqrt(math.max(0, 1 - pearson * pearson))
    [stdDev, pearson]

calcRegBounds(source, length, slope, intercept) =>
    // Loop for min/max deviations (Run only on last bar)
    upDev = 0.0
    dnDev = 0.0
    calc_periods = length - 1
    val = intercept
    for j = 0 to calc_periods by 1
        priceH = high[j] - val
        if priceH > upDev
            upDev := priceH
        priceL = val - low[j]
        if priceL > dnDev
            dnDev := priceL
        val += slope
    [upDev, dnDev]

getRegColors() =>
    switch regColorTheme
        "DARK" => [color.white, color.blue]
        "BRIGHT" => [color.green, color.red]
        "NEON" => [color.lime, color.fuchsia]
        => [color.white, color.blue]

[regBullColor, regBearColor] = getRegColors()


// LIQUIDITY ZONE METHODS



f_cleanupLiq(_arr) =>
    if array.size(_arr) > 0
        for i = array.size(_arr) - 1 to 0
            lvl = array.get(_arr, i)
            // Distance cull: a bear zone above price is never mitigated (that requires a
            // close above it), so without this the array only ever grows and levels
            // hundreds of points away stay drawn forever, burning the box/label budget.
            bool tooFar = cullFarZones and not isVisible(lvl.price, maxZoneDistAtr)
            // Remove if inactive, too far, or too old
            bool shouldDelete = not lvl.active or tooFar or (useLookbackLiq and (bar_index - lvl.createdBar) > lookbackLenLiq)
            if shouldDelete
                box.delete(lvl.bx)
                line.delete(lvl.liqLine)
                array.remove(_arr, i)


// RPD CORE SIGNAL ENGINE


hlc3_smooth = ta.wma((high + low + close) / 3, 3)

calculateEntropy(series, length) =>
    float isUp = (series > series[1]) ? 1.0 : 0.0
    float p = ta.sma(isUp, length)
    p > 0.0 and p < 1.0 ? (-p * math.log(p) - (1.0 - p) * math.log(1.0 - p)) / math.log(2.0) : 0.5

quantumStateAnalysis(price, states, period) =>
    hi = ta.highest(price, period)
    lo = ta.lowest(price, period)
    priceRangeVal = hi - lo
    state = priceRangeVal > 0 ? math.round((price - lo) / priceRangeVal * (states - 1)) : 0
    [state, priceRangeVal > 0 ? (price - lo) / priceRangeVal : 0]

psr(series, period) =>
    velocity = series - series[math.round(period / 2)]
    [velocity, velocity - velocity[1]]

[state, _] = quantumStateAnalysis(hlc3_smooth, analysisLevels, adaptivePeriod)
[psr_velocity, psr_acceleration] = psr(hlc3_smooth, adaptivePeriod)
entropy = calculateEntropy(hlc3_smooth, adaptivePeriod)
rsi = ta.rsi(close, rsiLen)
rsiTopCond = enableRSI ? rsi > rsiTop : false
rsiBotCond = enableRSI ? rsi < rsiBot : false
// volSpike calculated below with volAvg for consistency
isPivotHigh = high[1] > high[2] and high[1] > high
isPivotLow = low[1] < low[2] and low[1] < low
isFractalHigh = false
isFractalLow = false
if bar_index >= fractalStrength * 2
    center = fractalStrength
    isFractalHigh := true
    isFractalLow := true
    int i = 1
    while i <= fractalStrength
        if nz(high[center]) <= nz(high[center + i]) or nz(high[center]) <= nz(high[center - i])
            isFractalHigh := false
        if nz(low[center]) >= nz(low[center + i]) or nz(low[center]) >= nz(low[center - i])
            isFractalLow := false
        i += 1

isPeakEventBase = (isPivotHigh or isFractalHigh[1]) and close < low[1]
isValleyEventBase = (isPivotLow or isFractalLow[1]) and close > high[1]
peak_price_at_pivot = high[1]
valley_price_at_pivot = low[1]
var float last_valid_peak_price = na
var float last_valid_peak_velocity = na
var float last_valid_valley_price = na
var float last_valid_valley_velocity = na
// MTF confluence — merged BEFORE all downstream consumers (fixes mutation-ordering bug
// where isPeakStateReqMet read the pre-merge value but calculateProbability read post-merge).
currentTFSeconds = timeframe.in_seconds()
mtfTFSeconds = currentTFSeconds * mtfMultiplier
string mtfTF = timeframe.from_seconds(mtfTFSeconds)
[mtfHigh, mtfLow, mtfClose] = request.security(syminfo.tickerid, mtfTF, [high, low, close], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
mtfIsPeak = not na(mtfHigh[1]) and mtfHigh[1] > nz(mtfHigh[2], mtfHigh[1]) and mtfHigh[1] > nz(mtfHigh, mtfHigh[1])
mtfIsValley = not na(mtfLow[1]) and mtfLow[1] < nz(mtfLow[2], mtfLow[1]) and mtfLow[1] < nz(mtfLow, mtfLow[1])
isPeakEvent = isPeakEventBase or (mtfIsPeak and close < nz(mtfLow[1], low[1]))
isValleyEvent = isValleyEventBase or (mtfIsValley and close > nz(mtfHigh[1], high[1]))
isBearishDivergence = isPeakEvent and not na(last_valid_peak_price) and (peak_price_at_pivot > last_valid_peak_price) and (psr_velocity[1] < last_valid_peak_velocity)
isBullishDivergence = isValleyEvent and not na(last_valid_valley_price) and (valley_price_at_pivot < last_valid_valley_price) and (psr_velocity[1] > last_valid_valley_velocity)
// Calculate trend change once per bar for consistency
var float rTrendChange = na
rTrendChange := ta.change(rTrend)
effectiveMinDistance = aggressiveMode ? 1 : minSignalDistance
effectiveEdgeSens = aggressiveMode ? 4 : edgeSensitivity
effectiveEntropyThresh = aggressiveMode ? 0.95 : entropyThreshold

isPeakStateReqMet = isPeakEvent and (state[1] >= analysisLevels - 1 - effectiveEdgeSens) and (rTrend == -1 or rTrendChange < 0)
isValleyStateReqMet = isValleyEvent and (state[1] <= effectiveEdgeSens) and (rTrend == 1 or rTrendChange > 0)
isPotentialPeak = predictiveMode and state >= analysisLevels - 1 - effectiveEdgeSens and psr_acceleration < 0 and entropy < effectiveEntropyThresh and rTrend == -1
isPotentialValley = predictiveMode and state <= effectiveEdgeSens and psr_acceleration > 0 and entropy < effectiveEntropyThresh and rTrend == 1
trendStrength = math.abs(ta.ema(psr_velocity, 10))
volAvg = ta.sma(volume, volLookback)
volRatio = volume / volAvg
volSpike = volRatio > volMultiplier

calculateProbability(p_entropy, isDivergence) =>
    base_score = 35 + (trendStrength / atr * 15) + (1 - p_entropy) * 8
    entropy_score = p_entropy < effectiveEntropyThresh ? 5 + (1 - p_entropy) * 5 : -5
    divergence_bonus = isDivergence ? 15 + math.abs(psr_acceleration) * 2 : 0
    rsi_bonus = (rsiTopCond and isPeakEvent) or (rsiBotCond and isValleyEvent) ? 5 + (rsi - 50) / 5 : 0
    vol_bonus = volSpike ? 5 + (volume / volAvg - 1) * 3 : 0
    adaptive_bonus = adaptiveEntropy and trendStrength > atr ? 5 + trendStrength * 0.5 : 0
    mtf_bonus = (mtfIsPeak and isPeakEvent) or (mtfIsValley and isValleyEvent) ? 10 : 0
    barRangeFactor = (high - low) / atr
    variation = barRangeFactor * 2 - 1.0
    raw_prob = base_score + entropy_score + divergence_bonus + rsi_bonus + vol_bonus + adaptive_bonus + mtf_bonus + variation
    math.min(99, math.max(40, math.round(raw_prob, 1)))

peakProb = isPeakStateReqMet or isPotentialPeak ? calculateProbability(entropy[1], isBearishDivergence) : na
valleyProb = isValleyStateReqMet or isPotentialValley ? calculateProbability(entropy[1], isBullishDivergence) : na
effectiveMinProb = minProbThreshold - (adaptiveEntropy ? (trendStrength / atr * 5) : 0)
var int lastSignalBar = na
// Gate signals on bar confirmation so live == backtest (no repaint).
validPeak = barConfirmed and enableRPD and (isPeakStateReqMet or isPotentialPeak) and (not na(peakProb) and peakProb >= effectiveMinProb) and (na(lastSignalBar) or (bar_index - lastSignalBar > effectiveMinDistance))
validValley = barConfirmed and enableRPD and (isValleyStateReqMet or isPotentialValley) and (not na(valleyProb) and valleyProb >= effectiveMinProb) and (na(lastSignalBar) or (bar_index - lastSignalBar > effectiveMinDistance))

if validPeak
    lastSignalBar := bar_index
    last_valid_peak_price := peak_price_at_pivot
    last_valid_peak_velocity := psr_velocity[1]
    lastSignalType := "Peak"
    lastPeakProb := peakProb
    // Phase 2 ledger: Peak = short, stop above the pivot high.
    f_ledgerRecord("RPD_Peak", close, -1, peak_price_at_pivot + atr * 0.1)
if validValley
    lastSignalBar := bar_index
    last_valid_valley_price := valley_price_at_pivot
    last_valid_valley_velocity := psr_velocity[1]
    lastSignalType := "Valley"
    lastValleyProb := valleyProb
    // Phase 2 ledger: Valley = long, stop below the pivot low.
    f_ledgerRecord("RPD_Valley", close, 1, valley_price_at_pivot - atr * 0.1)

// Single source of truth: barsSinceSignal is derived from lastSignalBar, never incremented.
// (Removes the double-count where the signal bar set 0 then the +=1 block made it 1, and
//  removes the conflicting reassignment in the dashboard section.)
barsSinceSignal = na(lastSignalBar) ? na : bar_index - lastSignalBar

// RPD Live Signal Mode
var bool livePeakEvent = false
var bool liveValleyEvent = false
var float livePeakProb = na
var float liveValleyProb = na
var label livePeakLabel = na
var label livePeakProbLabel = na
var label liveValleyLabel = na
var label liveValleyProbLabel = na
projectedClose = ta.linreg(close, 5, 0)
tentativePeakProb = calculateProbability(entropy, isBearishDivergence)
tentativeValleyProb = calculateProbability(entropy, isBullishDivergence)

if enableRPD and liveSignalMode and barstate.isrealtime
    projectedHigh = math.max(high, open)
    projectedLow = math.min(low, open)
    intraVelocity = close - open
    intraAcceleration = intraVelocity - (close[1] - open[1])
    livePeakEvent := projectedHigh > high[1] and projectedClose < projectedLow and intraAcceleration < 0 and entropy < effectiveEntropyThresh
    liveValleyEvent := projectedLow < low[1] and projectedClose > projectedHigh and intraAcceleration > 0 and entropy < effectiveEntropyThresh
    livePeakProb := livePeakEvent ? tentativePeakProb : na
    liveValleyProb := liveValleyEvent ? tentativeValleyProb : na
    if livePeakEvent and livePeakProb >= effectiveMinProb
        label.delete(livePeakLabel)
        label.delete(livePeakProbLabel)
        livePeakLabel := label.new(bar_index, projectedHigh + atr * 0.7, "!", color=color.new(color.black, 100), textcolor=color.new(bearColor, 70), style=label.style_none, size=f_get_size(signalSize))
        livePeakProbLabel := label.new(bar_index, projectedHigh + atr * 1.2, str.tostring(livePeakProb) + "%", color=color.new(color.black, 100), textcolor=color.new(bearColor, 70), style=label.style_none, size=f_get_size(signalSize))
    else
        label.delete(livePeakLabel)
        label.delete(livePeakProbLabel)
    if liveValleyEvent and liveValleyProb >= effectiveMinProb
        label.delete(liveValleyLabel)
        label.delete(liveValleyProbLabel)
        liveValleyLabel := label.new(bar_index, projectedLow - atr * 0.7, "!", color=color.new(color.black, 100), textcolor=color.new(bullColor, 70), style=label.style_none, size=f_get_size(signalSize))
        liveValleyProbLabel := label.new(bar_index, projectedLow - atr * 1.2, str.tostring(liveValleyProb) + "%", color=color.new(color.black, 100), textcolor=color.new(bullColor, 70), style=label.style_none, size=f_get_size(signalSize))
    else
        label.delete(liveValleyLabel)
        label.delete(liveValleyProbLabel)
else
    livePeakEvent := false
    liveValleyEvent := false
    livePeakProb := na
    liveValleyProb := na

if barstate.isconfirmed
    label.delete(livePeakLabel)
    label.delete(livePeakProbLabel)
    label.delete(liveValleyLabel)
    label.delete(liveValleyProbLabel)

var bool livePending = false
livePending := enableRPD and liveSignalMode and barstate.isrealtime and (not na(livePeakProb) or not na(liveValleyProb))

// RPD Fibonacci Levels
fib8_high = ta.highest(high, 8)
fib8_low = ta.lowest(low, 8)
fib13_high = ta.highest(high, 13)
fib13_low = ta.lowest(low, 13)
fib21_high = ta.highest(high, 21)
fib21_low = ta.lowest(low, 21)
fib34_high = ta.highest(high, 34)
fib34_low = ta.lowest(low, 34)
fib55_high = ta.highest(high, 55)
fib55_low = ta.lowest(low, 55)
var box activeChannelBox = na
var box stopZoneBox = na
var bool isTradeActive = false
var string activeSignalDirection = ""

if enableRPD and (validPeak or validValley)
    isTradeActive := true
    activeSignalDirection := validValley ? "long" : "short"
    if not na(activeChannelBox)
        box.delete(activeChannelBox)
        activeChannelBox := na
    if not na(stopZoneBox)
        box.delete(stopZoneBox)
        stopZoneBox := na

if enableRPD and barstate.isconfirmed and barstate.islast
    if showFibLevels
        fib_periods_display = array.from(8, 13, 21, 34, 55)
        fib_highs_display_arr = array.from(fib8_high, fib13_high, fib21_high, fib34_high, fib55_high)
        fib_lows_display_arr = array.from(fib8_low, fib13_low, fib21_low, fib34_low, fib55_low)
        fib_colors_arr = array.from(c_f8, c_f13, c_f21, c_f34, c_f55)
        var array<line> fibLines = array.new<line>()
        var array<label> fibLabels = array.new<label>()
        if array.size(fibLines) > 0
            for i = 0 to array.size(fibLines) - 1
                line.delete(array.get(fibLines, i))
        if array.size(fibLabels) > 0
            for i = 0 to array.size(fibLabels) - 1
                label.delete(array.get(fibLabels, i))
        array.clear(fibLines)
        array.clear(fibLabels)
        right_boundary = bar_index + 30
        used_positions = array.new<float>()
        min_spacing = atr * 0.5
        for i = 0 to array.size(fib_periods_display) - 1
            hi_val = array.get(fib_highs_display_arr, i)
            lo_val = array.get(fib_lows_display_arr, i)
            line_color = array.get(fib_colors_arr, i)
            period = array.get(fib_periods_display, i)
            if not na(hi_val)
                array.push(fibLines, line.new(bar_index, hi_val, right_boundary, hi_val, color=color.new(line_color, 30), width=1, style=line.style_dashed))
                can_place_label = true
                for used_pos in used_positions
                    if math.abs(hi_val - used_pos) < min_spacing
                        can_place_label := false
                if can_place_label
                    label_text = "F" + str.tostring(period) + " | RSI: " + str.tostring(rsi, "#.0")
                    array.push(fibLabels, label.new(right_boundary + 1, hi_val, label_text, color=color.new(line_color, 85), textcolor=color.new(line_color, 20), style=label.style_label_left, size=size.small))
                    array.push(used_positions, hi_val)
            if not na(lo_val)
                array.push(fibLines, line.new(bar_index, lo_val, right_boundary, lo_val, color=color.new(line_color, 30), width=1, style=line.style_dashed))
                can_place_label = true
                for used_pos in used_positions
                    if math.abs(lo_val - used_pos) < min_spacing
                        can_place_label := false
                if can_place_label
                    label_text = "F" + str.tostring(period) + " | RSI: " + str.tostring(rsi, "#.0")
                    array.push(fibLabels, label.new(right_boundary + 1, lo_val, label_text, color=color.new(line_color, 85), textcolor=color.new(line_color, 20), style=label.style_label_left, size=size.small))
                    array.push(used_positions, lo_val)
    if not na(activeChannelBox)
        box.delete(activeChannelBox)
        activeChannelBox := na
    if not na(stopZoneBox)
        box.delete(stopZoneBox)
        stopZoneBox := na
    if showActiveChannel and isTradeActive
        fib_highs_all = array.from(fib8_high, fib13_high, fib21_high, fib34_high, fib55_high)
        fib_lows_all = array.from(fib8_low, fib13_low, fib21_low, fib34_low, fib55_low)
        bool foundChannelThisBar = false
        for i = 0 to array.size(fib_highs_all) - 1
            hi_channel = array.get(fib_highs_all, i)
            lo_channel = array.get(fib_lows_all, i)
            if not na(hi_channel) and not na(lo_channel)
                if close > lo_channel and close < hi_channel
                    activeChannelBox := box.new(bar_index, lo_channel, bar_index + 40, hi_channel, bgcolor=color.new(#39FF14, rpdChannelTrans), border_color=na)
                    if activeSignalDirection == "long"
                        float lowerBoundary = na
                        for j = 0 to array.size(fib_highs_all) - 1
                            prev_hi = array.get(fib_highs_all, j)
                            if not na(prev_hi) and prev_hi < lo_channel and (na(lowerBoundary) or prev_hi > lowerBoundary)
                                lowerBoundary := prev_hi
                        if not na(lowerBoundary)
                            stopZoneBox := box.new(bar_index, lowerBoundary, bar_index + 40, lo_channel, bgcolor=color.new(#FF0000, rpdChannelTrans), border_color=na)
                    else if activeSignalDirection == "short"
                        float upperBoundary = na
                        for j = 0 to array.size(fib_lows_all) - 1
                            next_lo = array.get(fib_lows_all, j)
                            if not na(next_lo) and next_lo > hi_channel and (na(upperBoundary) or next_lo < upperBoundary)
                                upperBoundary := next_lo
                        if not na(upperBoundary)
                            stopZoneBox := box.new(bar_index, hi_channel, bar_index + 40, upperBoundary, bgcolor=color.new(#FF0000, rpdChannelTrans), border_color=na)
                    foundChannelThisBar := true
                    break
        if not foundChannelThisBar
            isTradeActive := false

// RPD Visuals
wave_period = math.round(adaptivePeriod * 1.5)
wave_outer = ta.sma(math.sin(2 * math.pi * bar_index / wave_period) * ta.stdev(hlc3_smooth, wave_period) * 1.5 + hlc3_smooth, 3)
wave_mid = hlc3_smooth + (wave_outer - hlc3_smooth) * 0.66
wave_core = hlc3_smooth + (wave_outer - hlc3_smooth) * 0.33
bool effShowHarmonic = enableRPD and showHarmonicWave and not isPresetMinimal
p_price = plot(effShowHarmonic ? hlc3_smooth : na, "Price", display=display.none)
p_core_fill = plot(effShowHarmonic ? wave_core : na, "Core", display=display.none)
p_mid_fill = plot(effShowHarmonic ? wave_mid : na, "Mid", display=display.none)
p_outer_fill = plot(effShowHarmonic ? wave_outer : na, "Outer", display=display.none)
fill(p_price, p_core_fill, color=effShowHarmonic ? color.new(quantumColor, 75) : na)
fill(p_core_fill, p_mid_fill, color=effShowHarmonic ? color.new(quantumColor, 85) : na)
fill(p_mid_fill, p_outer_fill, color=effShowHarmonic ? color.new(quantumColor, 95) : na)

// Refactored Entropy Particles using plotchar to save label limit
flow_strength = (enableRPD and showEntropyParticles and not isPresetMinimal) ? 1.0 - (entropy / effectiveEntropyThresh) : 0.0
bool showParticle = flow_strength > 0
color particle_color = psr_velocity > 0 ? color.new(bullColor, 50) : color.new(bearColor, 50)
float particle_y = psr_velocity > 0 ? low - atr * 0.1 : high + atr * 0.1

// We use two plotchars because size must be constant
plotchar(showParticle and flow_strength > 0.7 ? particle_y : na, "Entropy Particle Small", "•", location.absolute, color=particle_color, size=size.small)
plotchar(showParticle and flow_strength <= 0.7 ? particle_y : na, "Entropy Particle Tiny", "•", location.absolute, color=particle_color, size=size.tiny)


if enableRPD and validPeak
    isPredictive = isPotentialPeak and not isPeakStateReqMet
    peak_icon = isBearishDivergence ? '◈' : (isPredictive ? '?' : '▼')
    
    // RPD Visual Optimization (Phase 2)
    // The number printed on the chart is the DISPLAY probability — the measured win
    // rate for RPD_Peak when calibrated mode is on, not the heuristic score. This is
    // what removes the "label says 99%, dashboard says WEAK" contradiction.
    [peakEmp, peakN] = f_calStats("RPD_Peak")
    float peakShown = useCalibratedProb and peakN >= minCalSamples ? peakEmp : peakProb
    // WP-C2: until n >= minCalSamples the empirical rate is noise — render gray + "(w)".
    bool peakWarm = useCalibratedProb and peakN < minCalSamples

    // Smart Rendering: Hide low prob text, adjust size/color
    bool showText = peakShown >= tierShow
    if (optimizeForScalping or isPresetMinimal) and peakShown < tierShow
        showText := false

    bool allowRpdPeak = not isPresetMinimal or peakShown >= 60.0

    if allowRpdPeak
        string txt = showText ? str.tostring(peakShown, "#.0") + "%" + (peakWarm ? " (w)" : "") : ""

        // Size based on confidence - OPTIMIZED: Larger sizes for better visibility
        string sz = peakShown >= tierHigh ? size.large : size.normal

        // Saturation based on confidence (warmup overrides: gray = unproven sample)
        color baseCol = isPredictive ? color.new(bearColor, 50) : bearColor
        color finalCol = peakWarm ? color.new(#787B86, 10) : peakShown < tierFade ? color.new(baseCol, 30) : baseCol
        
        // Combine text and icon into a single label directly on the wick
        string labelText = peak_icon
        if showText
            labelText := txt + "\n" + peak_icon
            
        int targetBarIndex = isPredictive ? bar_index : bar_index - 1
        float peakY = isPredictive ? high + atr * 1.05 : high[1] + atr * 1.05
        
        label.new(targetBarIndex, peakY, text=labelText, xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.black, 100), textcolor=finalCol, style=label.style_none, size=sz, tooltip="RPD PEAK (Bearish Reversal)\n• " + (useCalibratedProb ? "Empirical win rate: " + str.tostring(peakShown, "#.1") + "%  (n=" + str.tostring(peakN) + " closed)" + (peakWarm ? " — WARMUP until n≥" + str.tostring(minCalSamples) : "") : "Probability: " + str.tostring(peakShown, "#.1") + "%") + "\n• Heuristic score: " + str.tostring(peakProb, "#.1") + "★ (score, not a win rate)\n• Type: " + (isBearishDivergence ? "Divergence ◈" : "Momentum Break ▼") + "\n\nConcept: Momentum exhaustion at swing high.\nStrategy:\n1. Reversal likely.\n2. Look for SHORT entries.\n3. Stop Loss above the Peak.")

if enableRPD and validValley
    isPredictive = isPotentialValley and not isValleyStateReqMet
    valley_icon = isBullishDivergence ? '◈' : (isPredictive ? '?' : '▲')
    
    // RPD Visual Optimization (Phase 2) — display probability, see peak block above.
    [valleyEmp, valleyN] = f_calStats("RPD_Valley")
    float valleyShown = useCalibratedProb and valleyN >= minCalSamples ? valleyEmp : valleyProb
    // WP-C2: until n >= minCalSamples the empirical rate is noise — render gray + "(w)".
    bool valleyWarm = useCalibratedProb and valleyN < minCalSamples

    bool showText = valleyShown >= tierShow
    if (optimizeForScalping or isPresetMinimal) and valleyShown < tierShow
        showText := false

    bool allowRpdValley = not isPresetMinimal or valleyShown >= 60.0

    if allowRpdValley
        string txt = showText ? str.tostring(valleyShown, "#.0") + "%" + (valleyWarm ? " (w)" : "") : ""

        // Size based on confidence - OPTIMIZED: Larger sizes for better visibility
        string sz = valleyShown >= tierHigh ? size.large : size.normal

        // Saturation based on confidence (warmup overrides: gray = unproven sample)
        color baseCol = isPredictive ? color.new(bullColor, 50) : bullColor
        color finalCol = valleyWarm ? color.new(#787B86, 10) : valleyShown < tierFade ? color.new(baseCol, 30) : baseCol

        // Combine text and icon into a single label directly on the wick
        string labelText = valley_icon
        if showText
            labelText := valley_icon + "\n" + txt
            
        int targetBarIndex = isPredictive ? bar_index : bar_index - 1
        float valleyY = isPredictive ? low - atr * 1.05 : low[1] - atr * 1.05
        
        label.new(targetBarIndex, valleyY, text=labelText, xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.black, 100), textcolor=finalCol, style=label.style_none, size=sz, tooltip="RPD VALLEY (Bullish Reversal)\n• " + (useCalibratedProb ? "Empirical win rate: " + str.tostring(valleyShown, "#.1") + "%  (n=" + str.tostring(valleyN) + " closed)" + (valleyWarm ? " — WARMUP until n≥" + str.tostring(minCalSamples) : "") : "Probability: " + str.tostring(valleyShown, "#.1") + "%") + "\n• Heuristic score: " + str.tostring(valleyProb, "#.1") + "★ (score, not a win rate)\n• Type: " + (isBullishDivergence ? "Divergence ◈" : "Momentum Break ▲") + "\n\nConcept: Momentum exhaustion at swing low.\nStrategy:\n1. Reversal likely.\n2. Look for LONG entries.\n3. Stop Loss below the Valley.")


// FVG METHODS


method draw(UnicornSetup this) =>
    // Calc Score (Phase 2)
    // We use current global market state for dynamic scoring.
    // Display probability, not the heuristic — so an FVG setup's A/A+ grade is driven
    // by the measured RPD win rate rather than a fabricated number.
    float rpdProb = f_displayProb(this.isBullish ? "RPD_Valley" : "RPD_Peak", this.isBullish ? valleyProb : peakProb)
    bool isTrend = this.isBullish ? (rTrend == 1) : (rTrend == -1) // Assuming rTrend global
    
    // Calculate Score (0-100)
    int score = calcSignalScore(isTrend, rpdProb, this.confluenceCount, false)
    
    // Check Signal Priority Filter
    bool showSetup = true
    if signalPriority == "A+ Only" and score < 80
        showSetup := false
    else if signalPriority == "A and A+ Only" and score < 65
        showSetup := false
    
    // Scalping Optimization & Minimal Preset: Filtering Low Quality
    if (optimizeForScalping or isPresetMinimal) and score < (isPresetMinimal ? 65 : 50)
        showSetup := false

    if showSetup and this.isActive
        color c = this.isBullish ? color.new(colBull, 0) : color.new(colBear, 0)
        
        // Visual Tiers based on Score
        // Grade A+ (80+): Solid, Thicker
        // Grade A (65-79): Standard
        // Grade B (50-64): Fainter
        int baseTrans = boxTransparency
        if score < 65
            baseTrans := math.min(90, boxTransparency + 20) // Fade B-grade
        else if score >= 80
            baseTrans := math.max(10, boxTransparency - 10) // Solid A+
            
        color cLight = this.isBullish ? color.new(colBull, baseTrans) : color.new(colBear, baseTrans)
        color cBorder = this.isBullish ? color.new(colBull, borderTransparency) : color.new(colBear, borderTransparency)
        
        // Scalping Mode Adjustments
        string breakerText = ""
        string fvgText = ""
        if optimizeForScalping or isPresetMinimal
            // Simplify text: No Breaker Label, Simple FVG Box
            fvgText := "" // No text inside box for clean look
        else
            breakerText := compactLabels ? this.timeframe : "BREAKER [" + this.timeframe + "]"
            fvgText := compactLabels ? "FVG" : "FVG ZONE"
        
        // Draw Breaker Box
        if na(this.breakerBox)
            int rightEdge = autoExtendBoxes ? bar_index + 10 : bar_index + 5
            
            this.breakerBox := box.new(
                 left = this.breaker.index + boxLeftOffset, 
                 top = this.breaker.top, 
                 right = rightEdge, 
                 bottom = this.breaker.bottom, 
                 border_color = cBorder, 
                 bgcolor = cLight,
                 border_width = score >= 80 ? 2 : 1, // Thicker border for A+
                 text = breakerText,
                 text_color = color.new(c, textTransparency),
                 text_size = size.tiny
            )
            // Connector Line (Hide in scalping mode if grade B)
            if boxLeftOffset > 0 and (score >= 65 or not optimizeForScalping)
                line.new(this.breaker.index, (this.breaker.top + this.breaker.bottom)/2, this.breaker.index + boxLeftOffset, (this.breaker.top + this.breaker.bottom)/2, color=color.new(c, 50), style=line.style_dotted)
        else if this.isActive and autoExtendBoxes and barstate.islast
            box.set_right(this.breakerBox, bar_index + 10)

        // Draw FVG Box
        if na(this.fvgBox)
            int rightEdge = autoExtendBoxes ? bar_index + 10 : bar_index + 5
            int fvgTrans = showGradient ? baseTrans - 5 : baseTrans + 5

            this.fvgBox := box.new(
                 left = this.fvg.index + boxLeftOffset, 
                 top = this.fvg.top, 
                 right = rightEdge, 
                 bottom = this.fvg.bottom, 
                 border_color = color.new(c, borderTransparency + 30), 
                 bgcolor = color.new(c, fvgTrans),
                 border_width = score >= 80 ? 2 : 1,
                 border_style = line.style_solid,
                 text = fvgText,
                 text_color = color.new(c, textTransparency + 20),
                 text_size = size.small
            )
        else if this.isActive and autoExtendBoxes and barstate.islast
            box.set_right(this.fvgBox, bar_index + 10)
        
        // Draw Stop Line
        if showStopLine and na(this.stopLine)
            int rightEdge = autoExtendBoxes ? bar_index + 10 : bar_index + 5
            color stopColor = this.isBullish ? color.new(#FF3366, 0) : color.new(#00FF88, 0)
            
            this.stopLine := line.new(
                x1 = this.fvg.index + boxLeftOffset,
                y1 = this.stopPrice,
                x2 = rightEdge,
                y2 = this.stopPrice,
                color = color.new(stopColor, 40),
                width = 1,
                style = line.style_dashed
            )
        else if showStopLine and not na(this.stopLine) and this.isActive and autoExtendBoxes and barstate.islast
            line.set_x2(this.stopLine, bar_index + 10)
            
        // Draw Label
        if na(this.infoLabel)
            string emoji = this.isBullish ? "↗" : "↘"
            string priceStr = showPrice ? str.tostring(this.entryPrice, format.mintick) : ""
            
            string labelText = ""
            
            if optimizeForScalping or isPresetMinimal
                // Minimal Labels for Scalping / Minimalist Preset
                if score >= 65 
                    // Show Entry only for decent signals (A/A+)
                    labelText := (this.isBullish ? "L" : "S") + " " + priceStr 
                else
                    // Tiny dot or minimal for B-grade
                    labelText := "•"
            else
                labelText := emoji + " " + this.timeframe + (showPrice ? "\n" + priceStr : "")
            
            float labelY = this.isBullish ? this.fvg.bottom : this.fvg.top
            string labelStyle = this.isBullish ? label.style_label_up : label.style_label_down
            
            // Calculate risk/reward info for tooltip
            float distance = math.abs(this.entryPrice - this.stopPrice)
            string riskInfo = "Risk: " + str.tostring(distance, format.mintick) + " points"
            string tooltipText = (this.isBullish ? "Bullish" : "Bearish") + " Setup\n" + "Score: " + str.tostring(score) + "/100\nTimeframe: " + this.timeframe + "\n" + "Entry: " + str.tostring(this.entryPrice, format.mintick) + "\n" + "Stop: " + str.tostring(this.stopPrice, format.mintick) + "\n" + riskInfo
            
            this.infoLabel := label.new(
                 x = this.fvg.index + boxLeftOffset, 
                 y = labelY, 
                 text = labelText, 
                 color = color.new(c, textTransparency), 
                 style = labelStyle,
                 textcolor = c_text_primary,
                 size = compactLabels ? size.small : size.normal,
                 tooltip = tooltipText
            )
        
        if not na(this.infoLabel) and this.isActive
            label.set_x(this.infoLabel, this.fvg.index)
        
        // Draw Confluence Label (Star for A+)
        bool meetsConfluenceGate = this.confluenceCount >= minConfluenceTFs
        if showConfluence and score >= 80 and meetsConfluenceGate and na(this.confluenceLabel)
            string confluenceText = "🌟 A+"
            float confluenceY = this.isBullish ? this.fvg.top + (atr * 0.3) : this.fvg.bottom - (atr * 0.3)
            label newConfluenceLabel = label.new(
                x = this.fvg.index + boxLeftOffset,
                y = confluenceY,
                text = confluenceText,
                color = color.new(#FFD700, textTransparency),
                textcolor = color.black,
                style = this.isBullish ? label.style_label_down : label.style_label_up,
                size = size.small,
                tooltip = "High Confluence A+ Setup"
            )
            this.confluenceLabel := newConfluenceLabel
        
        if showConfluence and score >= 80 and meetsConfluenceGate and this.isActive and not na(this.confluenceLabel)
            label.set_x(this.confluenceLabel, this.fvg.index)

method validate(UnicornSetup this) =>
    if this.isActive
        this.barsActive += 1
        bool invalid = false
        
        // Check invalidation
        float checkPriceHigh = invalidationMode == "Wick" ? high : close
        float checkPriceLow = invalidationMode == "Wick" ? low : close
        
        if this.isBullish 
            if checkPriceLow < this.stopPrice
                invalid := true
        else 
            if checkPriceHigh > this.stopPrice
                invalid := true
        
        // Check max bars active
        if this.barsActive > maxBarsActive
            invalid := true
            
        if invalid
            this.isActive := false
            // Always delete/hide drawings when invalidated
            box.delete(this.breakerBox)
            box.delete(this.fvgBox)
            line.delete(this.stopLine)
            label.delete(this.infoLabel)
            this.breakerBox := na
            this.fvgBox := na
            this.stopLine := na
            this.infoLabel := na
            label.delete(this.confluenceLabel)
            this.confluenceLabel := na
            
            // If deleteInvalid is OFF, recreate with faded colors (Unless optimizeForScalping is ON)
            if not deleteInvalid and not optimizeForScalping
                color c = this.isBullish ? color.new(colBull, 0) : color.new(colBear, 0)
                int rightEdge = autoExtendBoxes ? bar_index + 10 : bar_index + 5
                
                this.breakerBox := box.new(
                     left = this.breaker.index, 
                     top = this.breaker.top, 
                     right = rightEdge, 
                     bottom = this.breaker.bottom, 
                     border_color = color.new(color.gray, 80), 
                     bgcolor = color.new(color.gray, 95),
                     border_width = 1,
                     text = "✕",
                     text_color = color.new(color.gray, 60),
                     text_size = size.tiny,
                     text_halign = text.align_center,
                     text_valign = text.align_center
                )
                
                this.fvgBox := box.new(
                     left = this.fvg.index, 
                     top = this.fvg.top, 
                     right = rightEdge, 
                     bottom = this.fvg.bottom, 
                     border_color = color.new(color.gray, 90), 
                     bgcolor = color.new(color.gray, 97),
                     border_width = 1,
                     border_style = line.style_dotted
                )
            
    if this.isActive
        this.draw()

method isLevelInvalidated(float level, int startIndex, int endIndex, bool checkBelow, string mode) =>
    bool invalidated = false
    int len = math.min(endIndex - startIndex - 1, 100)
    if len >= 1
        for i = 1 to len
            float priceToCheck = mode == "Wick" ? (checkBelow ? low[i] : high[i]) : close[i]
            if checkBelow ? (priceToCheck < level) : (priceToCheck > level)
                invalidated := true
                break
    invalidated


// CONFLUENCE DETECTION


calculateConfluence(UnicornSetup newSetup) =>
    int confluence = 1  // Count itself
    float priceTolerance = atr * 0.5  // Price range for confluence
    
    for s in activeSetups
        if s.isActive and s.isBullish == newSetup.isBullish
            // Check if setups are in similar price zones
            bool priceOverlap = not (s.fvg.bottom > newSetup.fvg.top or s.fvg.top < newSetup.fvg.bottom)
            bool entryNear = math.abs(s.entryPrice - newSetup.entryPrice) < priceTolerance
            
            if priceOverlap or entryNear
                confluence += 1
    
    confluence


// FVG QUALITY FILTERS (with optional RPD filtering)


passQualityFilters(bool isBull, float entry, float stop, float candleSize, float fvgTop, float fvgBot) =>
    bool pass = true
    
    if not enableFilters
        pass := true
    else
        // 1. Risk/Reward Filter
        float risk = math.abs(entry - stop)
        float fvgSize = math.abs(entry - (isBull ? fvgTop : fvgBot))
        float potentialReward = fvgSize * 2  // Assume 2x FVG size as target
        float rr = risk > 0 ? potentialReward / risk : 0
        
        if rr < minRiskReward
            pass := false
        
        // 2. Trend Alignment Filter
        if pass and filterTrendAlignment
            if isBull and isDowntrend
                pass := false
            if not isBull and isUptrend
                pass := false
        
        // 3. Volatility Filter
        if pass and filterVolatility
            if not isHighVolatility
                pass := false
        
        // 4. Candle Size Filter
        if pass and filterPriceAction
            if candleSize < (atr * minCandleSize)
                pass := false
        
        // 5. RPD Filter (if enabled)
        // Uses the display probability so this filter and the labels agree. Note that
        // rpdFilterMinProb defaults to 60 — on the empirical scale that is a demanding
        // bar, which is the intent: don't take FVGs behind an RPD that doesn't work.
        if pass and useRPDasFilter and enableRPD
            float heuristic = isBull ? (not na(valleyProb) ? valleyProb : 0) : (not na(peakProb) ? peakProb : 0)
            float currentProb = nz(f_displayProb(isBull ? "RPD_Valley" : "RPD_Peak", heuristic), 0)
            if currentProb < rpdFilterMinProb
                pass := false
    
    pass


// FVG SWING DETECTION (CURRENT TIMEFRAME)


float ph = ta.pivothigh(high, swingLength, swingLength)
float pl = ta.pivotlow(low, swingLength, swingLength)

if not na(ph)
    Swing newSwing = Swing.new(ph, bar_index[swingLength], true)
    swings.push(newSwing)
    if swings.size() > 30
        swings.shift() 

if not na(pl)
    Swing newSwing = Swing.new(pl, bar_index[swingLength], false)
    swings.push(newSwing)
    if swings.size() > 30
        swings.shift()


// FVG DETECTION (CURRENT TIMEFRAME)


bool isBullFVG = high[2] < low[0]
float bullFvgTop = low[0]
float bullFvgBot = high[2]

bool isBearFVG = low[2] > high[0]
float bearFvgTop = low[2]
float bearFvgBot = high[0]

// Effective size gate: ATR multiple, scaled by the volatility regime, floored in ticks.
float atrBaseline   = ta.sma(atr, 50)
float atrRegime     = atrBaseline > 0 ? atr / atrBaseline : 1.0
float fvgMinSizeCTF = math.max(atr * fvgThreshold * f_fvgRegimeMult(atrRegime), syminfo.mintick * fvgMinTicks)

bool validBullFVG = isBullFVG and (bullFvgTop - bullFvgBot) > fvgMinSizeCTF
bool validBearFVG = isBearFVG and (bearFvgTop - bearFvgBot) > fvgMinSizeCTF


// FVG CURRENT TIMEFRAME SETUP DETECTION


if enableFVG and showCurrent and barConfirmed
    // Count setups for current timeframe and check last setup time
    int ctfSetupCount = 0
    int lastSetupBar = -999
    for s in activeSetups
        if s.timeframe == "CTF" and s.isActive
            ctfSetupCount += 1
            if s.id > lastSetupBar
                lastSetupBar := s.id
    
    bool canCreateNew = (bar_index - lastSetupBar) >= minBarsBetween

    // BULLISH SETUP
    if validBullFVG and ctfSetupCount < maxActiveSetups and canCreateNew
        if swings.size() > 0
            for i = swings.size() - 1 to 0
                Swing s = swings.get(i)
                
                bool isFirstBreak = isLevelInvalidated(s.price, s.index, bar_index, false, invalidationMode) == false
                bool isBodyBreak = close > s.price and open < close 
                
                if s.isHigh and isBodyBreak and isFirstBreak
                    int offset = bar_index - s.index
                    float bOpen = open[offset]
                    float bClose = close[offset]
                    
                    float breakerTop = math.max(bOpen, bClose)
                    float breakerBot = math.min(bOpen, bClose)
                    
                    bool overlap = not (breakerBot > bullFvgTop or breakerTop < bullFvgBot)
                    
                    if overlap
                        float stop = math.min(low[0], low[1], low[2])
                        float candleSize = math.abs(close - open)
                        
                        // Apply quality filters (includes RPD filter if enabled)
                        if passQualityFilters(true, bullFvgBot, stop, candleSize, bullFvgTop, bullFvgBot)
                            CandleRange brk = CandleRange.new(breakerTop, breakerBot, s.index, true)
                            FVG fvg = FVG.new(bullFvgTop, bullFvgBot, bar_index, true, false)

                            UnicornSetup setup = UnicornSetup.new(
                                bar_index,
                                true,
                                brk,
                                fvg,
                                bullFvgBot,
                                stop,
                                na, na, na, na,
                                true,
                                0,
                                "CTF",
                                0,
                                na
                            )
                            activeSetups.push(setup)
                            setup.confluenceCount := calculateConfluence(setup)
                            setup.draw()
                            f_ledgerRecord("FVG_Bull", setup.entryPrice, 1, setup.stopPrice)
                            // Update confluence for existing setups
                            bool newSetupIsBullish = setup.isBullish
                            int newSetupId = setup.id
                            for existing in activeSetups
                                if existing.isActive and existing.isBullish == newSetupIsBullish and existing.id != newSetupId
                                    existing.confluenceCount := calculateConfluence(existing)
                                    if not na(existing.confluenceLabel)
                                        label.delete(existing.confluenceLabel)
                                        existing.confluenceLabel := na
                                    existing.draw()
                            break 

    // BEARISH SETUP
    if validBearFVG and ctfSetupCount < maxActiveSetups and canCreateNew
        if swings.size() > 0
            for i = swings.size() - 1 to 0
                Swing s = swings.get(i)
                
                bool isFirstBreak = isLevelInvalidated(s.price, s.index, bar_index, true, invalidationMode) == false
                bool isBodyBreak = close < s.price and open > close 

                if not s.isHigh and isBodyBreak and isFirstBreak
                    int offset = bar_index - s.index
                    float bOpen = open[offset]
                    float bClose = close[offset]
                    
                    float breakerTop = math.max(bOpen, bClose)
                    float breakerBot = math.min(bOpen, bClose)
                    
                    bool overlap = not (breakerBot > bearFvgTop or breakerTop < bearFvgBot)
                    
                    if overlap
                        float stop = math.max(high[0], high[1], high[2])
                        float candleSize = math.abs(close - open)
                        
                        // Apply quality filters (includes RPD filter if enabled)
                        if passQualityFilters(false, bearFvgTop, stop, candleSize, bearFvgTop, bearFvgBot)
                            CandleRange brk = CandleRange.new(breakerTop, breakerBot, s.index, false)
                            FVG fvg = FVG.new(bearFvgTop, bearFvgBot, bar_index, false, false)

                            UnicornSetup setup = UnicornSetup.new(
                                bar_index,
                                false,
                                brk,
                                fvg,
                                bearFvgTop,
                                stop,
                                na, na, na, na,
                                true,
                                0,
                                "CTF",
                                0,
                                na
                            )
                            activeSetups.push(setup)
                            setup.confluenceCount := calculateConfluence(setup)
                            setup.draw()
                            f_ledgerRecord("FVG_Bear", setup.entryPrice, -1, setup.stopPrice)
                            // Update confluence for existing setups
                            bool newSetupIsBullish = setup.isBullish
                            int newSetupId = setup.id
                            for existing in activeSetups
                                if existing.isActive and existing.isBullish == newSetupIsBullish and existing.id != newSetupId
                                    existing.confluenceCount := calculateConfluence(existing)
                                    if not na(existing.confluenceLabel)
                                        label.delete(existing.confluenceLabel)
                                        existing.confluenceLabel := na
                                    existing.draw()
                            // Indentation fix: this `break` used to sit one level out, inside
                            // `if overlap`, so a bearish candidate that failed the quality
                            // filters still aborted the swing scan while the bullish branch
                            // kept searching older swings. Same setup, different acceptance
                            // rule by direction — now both stop only after a setup is built.
                            break


// FVG MTF DETECTION


processTimeframeMTF(simple string tf, simple bool enabled, simple string tfLabel) =>
    if enabled and enableMTF and enableFVG and barConfirmed
        // A request.security() call to a timeframe BELOW the chart's own returns only the
        // last completed value inside the current bar, so every intra-bar event on that
        // timeframe is invisible and the pivot/ATR series are inconsistent with it.
        // Those detections may still be drawn (the user asked for them) but they must not
        // enter the calibration ledger, or they poison the empirical win rate.
        bool ledgerEligible = timeframe.in_seconds(tf) >= timeframe.in_seconds(timeframe.period)

        // Get HTF data
        [htfHigh2, htfLow0, htfLow2, htfHigh0, htfAtr, htfAtrAvg, htfPH, htfPL, htfOpen, htfClose, htfHigh, htfLow] = request.security(syminfo.tickerid, tf,
             [high[2], low, low[2], high, ta.atr(globalAtrLength), ta.sma(ta.atr(globalAtrLength), 50),
              ta.pivothigh(high, swingLength, swingLength),
              ta.pivotlow(low, swingLength, swingLength),
              open, close, high, low],
             lookahead=barmerge.lookahead_off)

        // Size gate computed on the requested timeframe's own volatility, not the chart's.
        float htfRegime  = htfAtrAvg > 0 ? htfAtr / htfAtrAvg : 1.0
        float htfMinSize = math.max(htfAtr * fvgThreshold * f_fvgRegimeMult(htfRegime), syminfo.mintick * fvgMinTicks)

        // Detect FVG
        bool htfBullFVG = htfHigh2 < htfLow0
        float htfBullTop = htfLow0
        float htfBullBot = htfHigh2
        bool htfValidBullFVG = htfBullFVG and (htfBullTop - htfBullBot) > htfMinSize

        bool htfBearFVG = htfLow2 > htfHigh0
        float htfBearTop = htfLow2
        float htfBearBot = htfHigh0
        bool htfValidBearFVG = htfBearFVG and (htfBearTop - htfBearBot) > htfMinSize
        
        // Count setups for this timeframe and check last setup time
        int tfSetupCount = 0
        int lastSetupBar = -999
        for s in activeSetups
            if s.timeframe == tfLabel and s.isActive
                tfSetupCount += 1
                if s.id > lastSetupBar
                    lastSetupBar := s.id
        
        bool canCreateNew = (bar_index - lastSetupBar) >= minBarsBetween
        
        // Bullish setup
        if htfValidBullFVG and not na(htfPH) and tfSetupCount < maxActiveSetups and canCreateNew
            if htfClose > htfPH and htfOpen < htfClose
                float breakerTop = math.max(htfOpen, htfClose)
                float breakerBot = math.min(htfOpen, htfClose)
                bool overlap = not (breakerBot > htfBullTop or breakerTop < htfBullBot)
                
                if overlap
                    float stopPrice = htfLow
                    float candleSize = math.abs(htfClose - htfOpen)
                    
                    // Apply quality filters (includes RPD filter if enabled)
                    if passQualityFilters(true, htfBullBot, stopPrice, candleSize, htfBullTop, htfBullBot)
                        CandleRange brk = CandleRange.new(breakerTop, breakerBot, bar_index - 1, true)
                        FVG fvg = FVG.new(htfBullTop, htfBullBot, bar_index, true, false)
                        
                        UnicornSetup setup = UnicornSetup.new(
                            bar_index, true, brk, fvg, htfBullBot, stopPrice,
                            na, na, na, na, true, 0, tfLabel, 0, na
                        )
                        activeSetups.push(setup)
                        setup.confluenceCount := calculateConfluence(setup)
                        setup.draw()
                        if ledgerEligible
                            f_ledgerRecord("FVG_Bull", setup.entryPrice, 1, setup.stopPrice)
        
        // Bearish setup
        if htfValidBearFVG and not na(htfPL) and tfSetupCount < maxActiveSetups and canCreateNew
            if htfClose < htfPL and htfOpen > htfClose
                float breakerTop = math.max(htfOpen, htfClose)
                float breakerBot = math.min(htfOpen, htfClose)
                bool overlap = not (breakerBot > htfBearTop or breakerTop < htfBearBot)
                
                if overlap
                    float stopPrice = htfHigh
                    float candleSize = math.abs(htfClose - htfOpen)
                    
                    // Apply quality filters (includes RPD filter if enabled)
                    if passQualityFilters(false, htfBearTop, stopPrice, candleSize, htfBearTop, htfBearBot)
                        CandleRange brk = CandleRange.new(breakerTop, breakerBot, bar_index - 1, false)
                        FVG fvg = FVG.new(htfBearTop, htfBearBot, bar_index, false, false)
                        
                        UnicornSetup setup = UnicornSetup.new(
                            bar_index, false, brk, fvg, htfBearTop, stopPrice,
                            na, na, na, na, true, 0, tfLabel, 0, na
                        )
                        activeSetups.push(setup)
                        setup.confluenceCount := calculateConfluence(setup)
                        setup.draw()
                        if ledgerEligible
                            f_ledgerRecord("FVG_Bear", setup.entryPrice, -1, setup.stopPrice)

// Process each timeframe - Get ALL higher timeframe data
// Scalping mode used to disable 2H/4H/D/W, which is backwards: HTF order flow is the
// context that makes a gold scalp worth taking — where the 4H/Daily imbalance sits is
// the edge, not noise. What actually needs suppressing when scalping is the sub-chart
// timeframes, whose detections are under-sampled by request.security() anyway (they
// return only the last completed value inside the current bar) and are already barred
// from the calibration ledger for that reason.
bool allowSubChartTF = not optimizeForScalping

processTimeframeMTF("3", show3min and allowSubChartTF, "3m")
processTimeframeMTF("5", show5min and allowSubChartTF, "5m")
processTimeframeMTF("15", show15min, "15m")
processTimeframeMTF("30", show30min, "30m")
processTimeframeMTF("60", show1hour, "1H")
processTimeframeMTF("120", show2hour, "2H")
processTimeframeMTF("240", show4hour, "4H")
processTimeframeMTF("D", showDaily, "D")
processTimeframeMTF("W", showWeekly, "W")


// HTF KEY LEVELS — non-repaint: read prior *closed* period only and gate on confirmation.
[pdhRaw, pdlRaw] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[pwhRaw, pwlRaw] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)
// Hold values until a new bar confirms; this is what makes live == backtest.
var float pdh = na
var float pdl = na
var float pwh = na
var float pwl = na
if barConfirmed
    pdh := pdhRaw
    pdl := pdlRaw
    pwh := pwhRaw
    pwl := pwlRaw

// Visual Variables for Lines
var line linePDH = na
var line linePDL = na
var line linePWH = na
var line linePWL = na

// Detect Period Changes to Start New Lines
bool newDay  = ta.change(time("D")) != 0
bool newWeek = ta.change(time("W")) != 0

// --- DAILY LEVELS (Darker/Thinner) ---
if showPDH
    if newDay
        // Start new lines (Clear history for "Only Today" view)
        line.delete(linePDH)
        line.delete(linePDL)
        linePDH := line.new(bar_index, pdh, bar_index, pdh, color=color.new(colPD, htfTrans), width=1, style=line.style_dashed)
        linePDL := line.new(bar_index, pdl, bar_index, pdl, color=color.new(colPD, htfTrans), width=1, style=line.style_dashed)
    else
        // Extend current lines
        line.set_x2(linePDH, bar_index)
        line.set_x2(linePDL, bar_index)
        // Ensure price stays consistent for the period (redundant but safe)
        line.set_y1(linePDH, pdh)
        line.set_y2(linePDH, pdh)
        line.set_y1(linePDL, pdl)
        line.set_y2(linePDL, pdl)

// --- WEEKLY LEVELS (Brighter/Thicker) ---
if showPWH
    if newWeek
        line.delete(linePWH)
        line.delete(linePWL)
        linePWH := line.new(bar_index, pwh, bar_index, pwh, color=color.new(colPW, htfTrans), width=2, style=line.style_solid)
        linePWL := line.new(bar_index, pwl, bar_index, pwl, color=color.new(colPW, htfTrans), width=2, style=line.style_solid)
    else
        line.set_x2(linePWH, bar_index)
        line.set_x2(linePWL, bar_index)
        line.set_y1(linePWH, pwh)
        line.set_y2(linePWH, pwh)
        line.set_y1(linePWL, pwl)
        line.set_y2(linePWL, pwl)

// Labels (Only on the last bar)
if barstate.islast
    if showPDH
        var label pdhLbl = na, label.delete(pdhLbl)
        var label pdlLbl = na, label.delete(pdlLbl)
        pdhLbl := label.new(bar_index + 3, pdh, "PDH", color=color.new(colPD, 100), textcolor=colPD, style=label.style_label_left, size=size.small)
        pdlLbl := label.new(bar_index + 3, pdl, "PDL", color=color.new(colPD, 100), textcolor=colPD, style=label.style_label_left, size=size.small)
        
    if showPWH
        var label pwhLbl = na, label.delete(pwhLbl)
        var label pwlLbl = na, label.delete(pwlLbl)
        pwhLbl := label.new(bar_index + 3, pwh, "PWH", color=color.new(colPW, 100), textcolor=colPW, style=label.style_label_left, size=size.small)
        pwlLbl := label.new(bar_index + 3, pwl, "PWL", color=color.new(colPW, 100), textcolor=colPW, style=label.style_label_left, size=size.small)

// ═══════════════════════════════════════════════════
// VWAP + FIBONACCI BANDS + GLOBEX OPEN (Visual Only)
// Ported from v9 uis-suite. Not used by signal engine.
// ═══════════════════════════════════════════════════

// Cornish-Fisher helpers (O(1) moment equations for fat-tail adjusted sigma)
f_skewness_vwap(float src, int length) =>
    float m1 = ta.sma(src, length)
    float m2 = ta.sma(src * src, length)
    float m3 = ta.sma(src * src * src, length)
    float sd = ta.stdev(src, length)
    float mu3 = m3 - 3.0 * m1 * m2 + 2.0 * m1 * m1 * m1
    sd > 0 ? mu3 / (sd * sd * sd) : 0.0

f_kurtosis_vwap(float src, int length) =>
    float m1 = ta.sma(src, length)
    float m2 = ta.sma(src * src, length)
    float m3 = ta.sma(src * src * src, length)
    float m4 = ta.sma(src * src * src * src, length)
    float sd = ta.stdev(src, length)
    float m1sq = m1 * m1
    float mu4 = m4 - 4.0 * m1 * m3 + 6.0 * m1sq * m2 - 3.0 * m1sq * m1sq
    float sdSq = sd * sd
    sdSq > 0 ? mu4 / (sdSq * sdSq) : 0.0

// VWAP anchored to resolution (default Daily)
t_vwap      = time(reso)
debut_vwap  = na(t_vwap[1]) or t_vwap > t_vwap[1]

var float addsource_vwap = 0.0
var float addvol_vwap    = 0.0
var float sn_vwap        = 0.0

float prev_vwap = na(addsource_vwap[1]) or addvol_vwap[1] == 0.0 ? hlc3 : addsource_vwap[1] / addvol_vwap[1]

if debut_vwap
    addsource_vwap := hlc3 * nz(volume)
    addvol_vwap    := nz(volume)
    sn_vwap        := 0.0
else
    addsource_vwap := addsource_vwap + hlc3 * nz(volume)
    addvol_vwap    := addvol_vwap + nz(volume)
    float current_vwap = addsource_vwap / addvol_vwap
    sn_vwap        := sn_vwap + nz(volume) * (hlc3 - prev_vwap) * (hlc3 - current_vwap)

float VWAP_val = addvol_vwap != 0 ? addsource_vwap / addvol_vwap : hlc3
float sd_val   = addvol_vwap != 0 ? math.sqrt(sn_vwap / addvol_vwap) : 0

// CF expansion on z_p = 1.0 quantile (O(1) closed-form calculation)
float residVWAP = hlc3 - VWAP_val
bool needCF = enableVWAP and showBands and useCFsigma
float residSkewVWAP = needCF ? f_skewness_vwap(residVWAP, 100) : 0.0
float residKurtVWAP = needCF ? f_kurtosis_vwap(residVWAP, 100) : 3.0
float z_p_vwap = 1.0
float cfAdj = useCFsigma ?
     z_p_vwap + (z_p_vwap * z_p_vwap - 1) * residSkewVWAP / 6.0 +
     (z_p_vwap * z_p_vwap * z_p_vwap - 3 * z_p_vwap) * (residKurtVWAP - 3) / 24.0 -
     (2 * z_p_vwap * z_p_vwap * z_p_vwap - 5 * z_p_vwap) * residSkewVWAP * residSkewVWAP / 36.0 :
     z_p_vwap
float sigmaAdj = sd_val * cfAdj
float Fibp2  = VWAP_val + fib2 * sigmaAdj
float Fibp1  = VWAP_val + fib1 * sigmaAdj
float Fibm1  = VWAP_val - fib1 * sigmaAdj
float Fibm2  = VWAP_val - fib2 * sigmaAdj
float Sigp1  = VWAP_val + sd_val
float Sigm1  = VWAP_val - sd_val

pVWAP  = plot(enableVWAP and showVWAPLine    ? VWAP_val : na, "VWAP",        color=color.new(color.orange, 0), linewidth=2)
pSigp1 = plot(enableVWAP and showSigmaBands  ? Sigp1    : na, "VWAP +1s",   color=color.new(#00BFFF, 30),     linewidth=1, style=plot.style_line)
pSigm1 = plot(enableVWAP and showSigmaBands  ? Sigm1    : na, "VWAP -1s",   color=color.new(#FF69B4, 30),     linewidth=1, style=plot.style_line)
pFibp2 = plot(enableVWAP and showBands       ? Fibp2    : na, "Fib +2.618s", color=color.new(color.red,  20),  linewidth=1)
pFibp1 = plot(enableVWAP and showBands       ? Fibp1    : na, "Fib +1.618s", color=color.new(color.red,  40),  linewidth=1)
pFibm1 = plot(enableVWAP and showBands       ? Fibm1    : na, "Fib -1.618s", color=color.new(color.lime, 40),  linewidth=1)
pFibm2 = plot(enableVWAP and showBands       ? Fibm2    : na, "Fib -2.618s", color=color.new(color.lime, 20),  linewidth=1)

fill(pFibp2, pFibp1, enableVWAP and showBands and showFill ? color.new(color.red,  88) : na, title="VWAP Supply Zone")
fill(pFibm2, pFibm1, enableVWAP and showBands and showFill ? color.new(color.lime, 88) : na, title="VWAP Demand Zone")

// Globex Open & Prior Day Close (visual reference lines)
// Globex Open & Prior Day Close — hold prior *closed* values to avoid intrabar repaint.
var float globex_open  = na
var float globex_close = na
if barConfirmed
    globex_open  := request.security(syminfo.tickerid, "1D", open,  lookahead=barmerge.lookahead_on)
    globex_close := request.security(syminfo.tickerid, "1D", close[1], lookahead=barmerge.lookahead_on)

pDailyOpen = plot(showDailyOpen ? globex_open  : na, "Globex Open",  color=color.new(color.blue,   0), linewidth=2, style=plot.style_circles)
pPrevClose = plot(showPrevClose ? globex_close : na, "Prior Close",  color=color.new(color.orange, 0), linewidth=1, style=plot.style_line, linestyle=plot.linestyle_dashed)


// FVG, Liquidity ALERTS


if barstate.isfirst
    var table infoBox = table.new(position.bottom_right, 1, 1, bgcolor = color.new(#1E222D, 95), border_width=1, border_color=color.new(#2A2E39, 80))
    table.cell(infoBox, 0, 0, "UIS-VIP | v7.4", text_color = color.new(color.gray, 30), text_halign = text.align_center, text_size = size.small)

bool newBullish = false
bool newBearish = false

if enableFVG and activeSetups.size() > 0
    UnicornSetup lastSetup = activeSetups.get(activeSetups.size() - 1)
    if lastSetup.id == bar_index
        // Check Priority for Alert
        int p = 1
        if lastSetup.confluenceCount >= 3
            p := 3
        else if lastSetup.confluenceCount >= 2
            p := 2
        
        bool allowAlert = true
        if signalPriority == "A+ Only" and p < 3
            allowAlert := false
        else if signalPriority == "A and A+ Only" and p < 2
            allowAlert := false
            
        if allowAlert
            if lastSetup.isBullish
                newBullish := true
            else
                newBearish := true



bool newLiqSweep = false
if barConfirmed and enableLiquidity
    for lvl in levelsH
        if lvl.active and high > lvl.price and close < lvl.price and ((bar_index - lvl.lastSweepBar) >= sweepCooldownBars)
            newLiqSweep := true
    for lvl in levelsL
        if lvl.active and low < lvl.price and close > lvl.price and ((bar_index - lvl.lastSweepBar) >= sweepCooldownBars)
            newLiqSweep := true

alertcondition(newLiqSweep, "💧 Liquidity Sweep", "💧 Liquidity swept at price level")

// Logic for Master Alert Message
bool anySignal = newBullish or newBearish or newLiqSweep or validPeak or validValley
string alertMsg = ""
if newBullish
    alertMsg := "Bullish FVG Setup"
else if newBearish
    alertMsg := "Bearish FVG Setup"
else if newLiqSweep
    alertMsg := "Liquidity Sweep"
else if validPeak
    alertMsg := "RPD Peak (Bearish Reversal)"
else if validValley
    alertMsg := "RPD Valley (Bullish Reversal)"

alertcondition(newBullish, "🟢 Bullish Setup", "🟢 LONG Setup on {{ticker}} ({{interval}}) | Price: {{close}}")
alertcondition(newBearish, "🔴 Bearish Setup", "🔴 SHORT Setup on {{ticker}} ({{interval}}) | Price: {{close}}")
alertcondition(validPeak, "📉 RPD Peak", "📉 RPD Peak Detected on {{ticker}} ({{interval}}) | Price: {{close}}")
alertcondition(validValley, "📈 RPD Valley", "📈 RPD Valley Detected on {{ticker}} ({{interval}}) | Price: {{close}}")
alertcondition(sweepPDH or sweepPWH, "⚡ HTF High Sweep (PDH/PWH)", "⚡ Premium Pool Swept (PDH/PWH) on {{ticker}} ({{interval}}) | Price: {{close}}")
alertcondition(sweepPDL or sweepPWL, "⚡ HTF Low Sweep (PDL/PWL)", "⚡ Discount Pool Swept (PDL/PWL) on {{ticker}} ({{interval}}) | Price: {{close}}")
alertcondition(anySignal, "🔥 ANY SIGNAL (Master Alert)", "🔥 Master Alert Triggered! Check Chart for Specific Signal (FVG/LIQ/RPD).")

// Dynamic Alert (Select "Any alert() function call" in TradingView)
if anySignal
    alert(syminfo.ticker + ": " + alertMsg, alert.freq_once_per_bar_close)


// FVG VALIDATION & CLEANUP


if enableFVG and activeSetups.size() > 0
    for i = activeSetups.size() - 1 to 0
        UnicornSetup s = activeSetups.get(i)
        s.validate()
        
        // Only remove from array if deleteInvalid is ON and setup is inactive
        if not s.isActive and deleteInvalid
            activeSetups.remove(i)

// Update confluence for all active setups periodically
if enableFVG and showConfluence and barConfirmed and activeSetups.size() > 0 and (bar_index % 5 == 0 or barstate.islast)
    for s in activeSetups
        if s.isActive
            int oldConfluence = s.confluenceCount
            s.confluenceCount := calculateConfluence(s)
            // Redraw if confluence changed
            if s.confluenceCount != oldConfluence
                if not na(s.confluenceLabel)
                    label.delete(s.confluenceLabel)
                    s.confluenceLabel := na
                s.draw()

// Clean up old inactive setups (keep last 20 for spacing logic even if deleteInvalid is ON)
if enableFVG and activeSetups.size() > maxActiveSetups * 7 + 20
    int removeCount = 0
    for i = 0 to activeSetups.size() - 1
        if removeCount >= 10
            break
        UnicornSetup s = activeSetups.get(i)
        if not s.isActive
            box.delete(s.breakerBox)
            box.delete(s.fvgBox)
            line.delete(s.stopLine)
            label.delete(s.infoLabel)
            label.delete(s.confluenceLabel)
            activeSetups.remove(i)
            removeCount += 1


// ════════════════════════════════════════════════════════════════════════════════
// PHASE 3 — ORDER-FLOW PROXY SUITE (closest-to-L2 build without tick data)
// Uses the classical bar-range delta proxy: delta = volume * ((C-L)-(H-C))/(H-L).
// Provides: per-bar delta, cumulative delta (CVD), delta imbalance, absorption,
// and CVD/price divergence. All gated on barConfirmed for live==backtest.
// ════════════════════════════════════════════════════════════════════════════════
string grp_of = "🩸 Order-Flow Proxy"
bool   enableOrderFlow   = input.bool(true,  "Enable Order-Flow Proxy", group=grp_of)
string ofVisualMode     = input.string("Institutional Bubbles", "Visual Mode", options=["Institutional Bubbles", "Legacy Text Labels", "Both"], group=grp_of, tooltip="Institutional Bubbles: Clean shape/size/color/opacity visual hierarchy with hover tooltips.\nLegacy: Text tags (Δ↑, CVD↗).\nBoth: Render both.")
string ofBubbleScale    = input.string("Small", "Bubble Size Scale", options=["Micro", "Small", "Normal", "Large"], group=grp_of, tooltip="Controls overall visual size of Order Flow bubbles: Micro (smallest), Small (compact), Normal (standard), Large (expanded).")
int    ofDeltaLen       = input.int(20, "Delta Avg Lookback", minval=2, group=grp_of)
float  ofImbMult        = input.float(2.0, "Imbalance Multiplier (x avg|Δ|)", minval=1.0, step=0.1, group=grp_of)
float  ofAbsVolMult     = input.float(1.8, "Absorption Volume Multiplier", minval=1.0, step=0.1, group=grp_of)
float  ofMinPercentile   = input.float(70.0, "Delta Bubble Min Percentile", minval=50.0, maxval=95.0, step=5.0, group=grp_of, tooltip="Minimum delta percentile required to show Delta Bubble. 70 = Top 30%.")
float  ofNeutralBand     = input.float(0.25, "Delta Neutral Band (x avg|Δ|)", minval=0.0, step=0.05, group=grp_of, tooltip="Delta magnitudes below this multiple of baseline avg|Δ| render in neutral gray rather than green/red.")
float  divMinPriceAtr    = input.float(0.5, "Divergence Min Price Move (x ATR)", minval=0.0, step=0.1, group=grp_of, tooltip="Minimum price move in ATR over lookback for divergence.")
float  divMinCvdSigma    = input.float(1.0, "Divergence Min CVD Move (x σ)", minval=0.0, step=0.25, group=grp_of, tooltip="Minimum CVD move in random-walk σ for divergence.")
int    ofPercentileLen   = input.int(200, "Percentile Lookback (Bars)", minval=20, maxval=500, group=grp_of)
bool   ofShowLabels      = input.bool(true, "Show OF Event Bubbles/Labels", group=grp_of)
bool   showCvdBubbles    = input.bool(true, "Show CVD Divergence Overlay", group=grp_of, tooltip="Toggle on-chart ◆ diamonds and text labels for CVD divergence. Disabling this leaves CVD active in the Dashboard and Confluence Score.")
string ofCvdDivMode      = input.string("Trigger Bar Only", "CVD Overlay Mode", options=["Trigger Bar Only", "Every Bar (Legacy)"], group=grp_of, tooltip="Trigger Bar Only: Draws CVD diamond ◆ ONLY on the initial bar where divergence appears (eliminates diamond spam).\nEvery Bar: Draws diamond ◆ on every bar divergence remains active.")
// --- True intrabar footprint (supersedes the range-location proxy where data allows) ---
bool   ofUseIntrabar     = input.bool(true, "Use Intrabar Tick-Rule Delta", group=grp_of, tooltip="Classifies each lower-timeframe bar inside the current bar as buy- or sell-initiated by the sign of its close-to-close change (Lee-Ready tick rule), then sums the volume on each side. This is what a footprint chart computes; the only thing it cannot see is the bid/ask quote at the instant of each print.\n\nWhen off — or when lower-timeframe data is unavailable (free plan, illiquid feed, or an intrabar TF that is not lower than the chart TF) — the script falls back to the range-location proxy: volume x ((C-L)-(H-C))/(H-L). That proxy is not order flow; it measures where the bar closed inside its own range and scales it by volume, so a doji on huge volume reads as balanced whether that came from genuine absorption or from nothing trading at all.\n\nThe active estimator is named in every bubble tooltip so you always know which one produced the number.")
string ofIntrabarTf      = input.timeframe("1", "Intrabar Timeframe", options=["1S", "5S", "15S", "30S", "1", "3", "5"], group=grp_of, tooltip="Must be strictly lower than the chart timeframe or the footprint is empty and the proxy is used instead. Finer = better classification but fewer bars of history (TradingView caps intrabar requests, and seconds-based timeframes need a paid plan). On a 5m gold chart, 1m gives ~5 intrabars per bar; 15S gives ~20 and is where the delta starts to resemble a real footprint.")
float  ofWickAbsAtr      = input.float(0.5, "Wick Absorption Min Wick (x ATR)", minval=0.1, step=0.1, group=grp_of, tooltip="Minimum wick length, in ATR, for a directional wick-absorption event. The plain absorption test elsewhere in this section only says 'delta was near zero on high volume' — it has no side. This one does: a long wick into a level on real volume that closes back away from it is supply or demand being defended at a specific price.")
float  ofWickAbsVol      = input.float(1.5, "Wick Absorption Min rVol", minval=1.0, step=0.1, group=grp_of, tooltip="Minimum relative volume (vs the 20-bar average) for a wick-absorption event. A long wick on thin volume is a gap in the book, not absorption.")

// Helper functions for percentile & score size mapping with distinct glyphs & scale setting
f_get_bubble_glyph_and_size(float pct, string scale) =>
    string glyph = "●"
    string sz = size.normal
    if pct >= 90.0 // XL (Top 10%)
        glyph := "⬤"
        sz := scale == "Micro" ? size.small : scale == "Small" ? size.normal : scale == "Large" ? size.huge : size.large
    else if pct >= 75.0 // L (75-90th percentile)
        glyph := "⬤"
        sz := scale == "Micro" ? size.tiny : scale == "Small" ? size.small : scale == "Large" ? size.large : size.normal
    else if pct >= 60.0 // M (60-75th percentile)
        glyph := "●"
        sz := scale == "Micro" ? size.tiny : scale == "Small" ? size.small : scale == "Large" ? size.normal : size.small
    else if pct >= 45.0 // S (45-60th percentile)
        glyph := "●"
        sz := scale == "Micro" ? size.tiny : scale == "Small" ? size.tiny : scale == "Large" ? size.small : size.tiny
    else // XS (30-45th percentile)
        glyph := "•"
        sz := size.tiny
    [glyph, sz]

f_get_score_glyph_and_size(float sc, string scale) =>
    string glyph = "●"
    string sz = size.normal
    if sc >= 90.0 // XL (90-100 score)
        glyph := "⬤"
        sz := scale == "Micro" ? size.small : scale == "Small" ? size.normal : scale == "Large" ? size.huge : size.large
    else if sc >= 75.0 // L (75-90 score)
        glyph := "⬤"
        sz := scale == "Micro" ? size.tiny : scale == "Small" ? size.small : scale == "Large" ? size.large : size.normal
    else if sc >= 60.0 // M (60-75 score)
        glyph := "●"
        sz := scale == "Micro" ? size.tiny : scale == "Small" ? size.small : scale == "Large" ? size.normal : size.small
    else if sc >= 40.0 // S (40-60 score)
        glyph := "•"
        sz := scale == "Micro" ? size.tiny : scale == "Small" ? size.tiny : scale == "Large" ? size.small : size.tiny
    else // XS (<40 score)
        glyph := "•"
        sz := size.tiny
    [glyph, sz]

// ── Per-bar delta ───────────────────────────────────────────────────────────────
// Two estimators, in descending order of fidelity:
//   1. Intrabar tick rule — a real footprint. Every lower-TF bar inside this bar is
//      classified buy- or sell-initiated and its volume added to that side. This also
//      yields a volume point-of-control: the price *level* inside the bar that traded
//      the most, which is what lets bubbles anchor to price instead of to a fixed offset.
//   2. Range-location proxy — volume x ((C-L)-(H-C))/(H-L). Retained as the fallback, but
//      it is a close-location estimate, not order flow. Used only when intrabar data is
//      unavailable, and always disclosed in the tooltip when it is.
[_ibO, _ibH, _ibL, _ibC, _ibV] = request.security_lower_tf(syminfo.tickerid, ofIntrabarTf, [open, high, low, close, volume])

f_intrabarFootprint(array<float> ibO, array<float> ibH, array<float> ibL, array<float> ibC, array<float> ibV) =>
    // request.security_lower_tf returns empty arrays when the requested TF is not strictly
    // lower than the chart TF, or when the plan/feed has no intrabar history for this bar.
    int n = na(ibC) ? 0 : array.size(ibC)
    float buyV = 0.0
    float sellV = 0.0
    float pocPrice = na
    float pocVol = 0.0
    if n > 0
        for i = 0 to n - 1
            float ci = array.get(ibC, i)
            float oi = array.get(ibO, i)
            float vi = array.get(ibV, i)
            if not (na(ci) or na(vi))
                float prev = i == 0 ? oi : array.get(ibC, i - 1)
                // Lee-Ready tick rule: uptick = buy-initiated, downtick = sell-initiated,
                // unchanged = fall back to the intrabar's own body direction.
                bool isBuy = na(prev) or ci == prev ? ci >= nz(oi, ci) : ci > prev
                if isBuy
                    buyV := buyV + vi
                else
                    sellV := sellV + vi
                // Volume point of control: keep the price of the heaviest intrabar. Guarded
                // so a feed with a na high/low on one intrabar cannot blank out a valid POC.
                float hi = array.get(ibH, i)
                float lo = array.get(ibL, i)
                if vi > pocVol and not (na(hi) or na(lo))
                    pocVol := vi
                    pocPrice := math.avg(hi, lo)
    [buyV - sellV, pocPrice, buyV, sellV, n]

[ibDelta, ibPoc, ibBuyV, ibSellV, ibCount] = f_intrabarFootprint(_ibO, _ibH, _ibL, _ibC, _ibV)
// Require >1 intrabar: a single intrabar carries no close-to-close sequence to classify.
bool ibOK = ofUseIntrabar and ibCount > 1

float _range = high - low
float proxyDelta = _range > 0 ? volume * ((close - low) - (high - close)) / _range : 0.0
float barDelta = ibOK ? ibDelta : proxyDelta
float absDelta = math.abs(barDelta)
// Bid:ask-style asymmetry between the two sides, independent of absolute size. A 3:1 read
// on modest volume is a different event from a 1.1:1 read on a huge bar; raw delta conflates
// them because it only reports the net.
float ibImbRatio = ibOK and math.min(ibBuyV, ibSellV) > 0 ? math.max(ibBuyV, ibSellV) / math.min(ibBuyV, ibSellV) : na

// Cumulative delta — reset on new anchor period (daily) or estimator flip to track session flow.
bool _newSession = ta.change(time("D")) != 0
var float cvd = 0.0
var int ibFlipBar = 0
if ibOK != ibOK[1]
    ibFlipBar := bar_index
int barsSinceFlip = bar_index - ibFlipBar
if barConfirmed
    cvd := (_newSession or ibOK != ibOK[1]) ? barDelta : cvd + barDelta

// Rolling average of |delta| for imbalance / absorption stats.
float avgAbsDelta = ta.sma(absDelta, ofDeltaLen)
bool  deltaImbalanceUp   = barDelta > 0 and absDelta > ofImbMult * avgAbsDelta
bool  deltaImbalanceDn   = barDelta < 0 and absDelta > ofImbMult * avgAbsDelta
// Absorption: high volume + delta near zero (pressure absorbed) + meaningful wick.
float _body = math.abs(close - open)
bool  absorption = barConfirmed and volume > ofAbsVolMult * ta.sma(volume, ofDeltaLen) and absDelta < 0.25 * avgAbsDelta and _body < 0.3 * _range

// --- STATISTICAL PERCENTILE & CONFIDENCE METRICS ---
float _deltaScale     = math.max(avgAbsDelta, math.max(ta.sma(volume, ofDeltaLen) * 0.01, 1e-6))
float deltaNorm       = absDelta / _deltaScale
float deltaPercentile = ta.percentrank(deltaNorm, ofPercentileLen)
float rVol = ta.sma(volume, 20) > 0 ? volume / ta.sma(volume, 20) : 1.0
// Bubble size blends delta rank with volume rank so a big net delta printed on unremarkable
// volume does not size the same as one printed on a genuine volume expansion.
float volPercentile = ta.percentrank(volume, ofPercentileLen)
float bubbleRank    = 0.7 * deltaPercentile + 0.3 * nz(volPercentile, deltaPercentile)

// CVD divergence vs price over the delta lookback with magnitude & estimator boundary gates.
float priceChg = close - close[ofDeltaLen]
float cvdChg   = cvd - cvd[ofDeltaLen]
float cvdNoise = _deltaScale * math.sqrt(ofDeltaLen)
float pThresh  = atr * divMinPriceAtr
float cThresh  = cvdNoise * divMinCvdSigma
bool  cvdWindowClean    = barsSinceFlip >= ofDeltaLen
bool  cvdBullDivergence = cvdWindowClean and priceChg < -pThresh and cvdChg > cThresh   // price down, buy-side accumulating
bool  cvdBearDivergence = cvdWindowClean and priceChg > pThresh and cvdChg < -cThresh    // price up, sell-side distributing

// --- DIRECTIONAL WICK ABSORPTION ---
// The absorption test above is side-agnostic. These are not: a long upper wick on real
// volume closing in the lower half is offers defended at a price; the mirror is bids.
float upperWick = high - math.max(open, close)
float lowerWick = math.min(open, close) - low
bool upperAbsorb = barConfirmed and upperWick > atr * ofWickAbsAtr and rVol > ofWickAbsVol and close < math.avg(high, low)
bool lowerAbsorb = barConfirmed and lowerWick > atr * ofWickAbsAtr and rVol > ofWickAbsVol and close > math.avg(high, low)

// Confidence score calculation (0 - 100%)
float cScoreDelta   = math.min(30.0, deltaNorm * 12.0)
float cScoreVol     = math.min(25.0, rVol * 10.0)
float cScoreRange   = math.min(20.0, ((high - low) / math.max(atr, 0.0001)) * 12.0)
float cScoreTrend   = (barDelta > 0 and close > VWAP_val) or (barDelta < 0 and close < VWAP_val) ? 15.0 : 0.0
float cScoreSession = not na(time(timeframe.period, "0830-1600")) ? 10.0 : 5.0
float confidenceScore = math.min(100.0, cScoreDelta + cScoreVol + cScoreRange + cScoreTrend + cScoreSession)

// Opacity mapping (0 = 100% solid, 20 = 80% confirmed, 40 = 60% moderate, 60 = 40% weak)
int confTransp = confidenceScore >= 80.0 ? 0 : confidenceScore >= 60.0 ? 20 : confidenceScore >= 40.0 ? 40 : 60

// --- INSTITUTIONAL CONFLUENCE SCORE (Total 100 pts) ---
float scoreDelta = (deltaImbalanceUp or deltaImbalanceDn) ? 20.0 : 0.0
float scoreCvd   = (cvdBullDivergence or cvdBearDivergence) ? 20.0 : 0.0
float scoreLiq   = (low < ta.lowest(low[1], 20) and close > low[1]) or (high > ta.highest(high[1], 20) and close < high[1]) ? 20.0 : 0.0
float scoreVwap  = (barDelta > 0 and close > VWAP_val) or (barDelta < 0 and close < VWAP_val) ? 10.0 : 0.0
float scoreVol   = rVol >= 1.5 ? 10.0 : 0.0
float scoreReg   = math.abs(close - VWAP_val) > atr * 0.5 ? 10.0 : 0.0
float scoreMS    = msState.trendDir != 0 ? 10.0 : 0.0
float totalConfluenceScore = scoreDelta + scoreCvd + scoreLiq + scoreVwap + scoreVol + scoreReg + scoreMS

// Color tokens for institutional bubble system
color c_delta_bull = color.new(color.rgb(0, 230, 118), confTransp)   // Bright Green
color c_delta_bear = color.new(color.rgb(255, 23, 68), confTransp)   // Bright Red
color c_cvd_bull   = color.new(color.rgb(0, 176, 255), confTransp)   // Cyan-Blue
color c_cvd_bear   = color.new(color.rgb(255, 109, 0), confTransp)   // Bright Orange
color c_confluence = color.new(color.rgb(124, 77, 255), confTransp)  // Deep Violet

bool showBubbles = ofShowLabels and (ofVisualMode == "Institutional Bubbles" or ofVisualMode == "Both")
bool showLegacy  = ofShowLabels and (ofVisualMode == "Legacy Text Labels" or ofVisualMode == "Both")

// Order-flow event signals (write to ledger + draw bubbles/labels).
if enableOrderFlow and barConfirmed
    // Ledger recording
    if deltaImbalanceUp
        f_ledgerRecord("OF_ImbUp", close, 1, low - atr * syntheticR_atr)
    if deltaImbalanceDn
        f_ledgerRecord("OF_ImbDn", close, -1, high + atr * syntheticR_atr)
    if upperAbsorb
        f_ledgerRecord("OF_AbsHi", close, -1, high)
    if lowerAbsorb
        f_ledgerRecord("OF_AbsLo", close, 1, low)

    // 1. INSTITUTIONAL DELTA BUBBLE (Tier 1: ±0.35 ATR)
    float effMinPercentile = isPresetMinimal ? math.max(80.0, ofMinPercentile) : (isPresetOF ? math.min(60.0, ofMinPercentile) : ofMinPercentile)
    if showBubbles and deltaPercentile >= effMinPercentile and rVol > 1.0
        bool isBull = barDelta > 0
        // Direction-encoded Tier 1 vertical placement (±0.35 ATR)
        float bY = isBull ? low - (atr * 0.35) : high + (atr * 0.35)
        color bCol = isBull ? c_delta_bull : c_delta_bear
        string dTip = "[ INSTITUTIONAL DELTA IMBALANCE ]\n" +
                      "Source: " + (ibOK ? "Intrabar tick rule (" + ofIntrabarTf + ", " + str.tostring(ibCount) + " bars)" : "Range-location proxy (no intrabar data)") + "\n" +
                      "Direction: " + (isBull ? "BUY-SIDE AGGRESSION (Δ↑)" : "SELL-SIDE AGGRESSION (Δ↓)") + "\n" +
                      "Delta: " + (isBull ? "+" : "") + str.tostring(barDelta, "#.#") + " (" + str.tostring(deltaPercentile, "#.#") + "th Percentile, normalized)\n" +
                      (ibOK ? "Buy / Sell Vol: " + str.tostring(ibBuyV, "#.#") + " / " + str.tostring(ibSellV, "#.#") + "\n" : "") +
                      (na(ibImbRatio) ? "" : "Imbalance Ratio: " + str.tostring(ibImbRatio, "#.##") + " : 1\n") +
                      (na(ibPoc) ? "" : "Volume POC: " + str.tostring(ibPoc, format.mintick) + "\n") +
                      "Relative Volume: " + str.tostring(rVol, "#.##") + "x\n" +
                      "ATR Ratio: " + str.tostring(_range / math.max(atr, 0.0001), "#.##") + "x\n" +
                      "VWAP: " + (close > VWAP_val ? "Above" : "Below") + "\n" +
                      "Structure: " + (msState.trendDir == 1 ? "Bullish" : msState.trendDir == -1 ? "Bearish" : "Neutral") + "\n" +
                      "Confidence: " + str.tostring(confidenceScore, "#.#") + "%"
        [dGlyph, dSize] = f_get_bubble_glyph_and_size(bubbleRank, ofBubbleScale)
        label.new(bar_index, bY, dGlyph, color=color.new(color.black, 100), textcolor=bCol, style=label.style_none, size=dSize, tooltip=dTip)

    // 2. CVD DIVERGENCE BUBBLE (Tier 2: ±0.65 ATR)
    bool cvdDivTrigger = ofCvdDivMode == "Trigger Bar Only" ? 
                         ((cvdBullDivergence and not cvdBullDivergence[1]) or (cvdBearDivergence and not cvdBearDivergence[1])) : 
                         (cvdBullDivergence or cvdBearDivergence)
    if showBubbles and showCvdBubbles and cvdDivTrigger
        float priceChgNorm = math.abs(priceChg) / math.max(atr, 0.0001)
        float cvdChgNorm   = math.abs(cvdChg) / _deltaScale
        float divScore     = math.min(100.0, (priceChgNorm * 18.0) + (cvdChgNorm * 18.0) + (rVol * 10.0) + 30.0)
        bool isBullDiv     = cvdBullDivergence
        float divY         = isBullDiv ? low - (atr * 0.65) : high + (atr * 0.65)
        color divCol       = isBullDiv ? c_cvd_bull : c_cvd_bear
        string divTip      = "[ INSTITUTIONAL CVD DIVERGENCE ]\n" +
                             "Type: " + (isBullDiv ? "Bullish Accumulation (Price ↓, CVD ↑)" : "Bearish Distribution (Price ↑, CVD ↓)") + "\n" +
                             "Price Delta: " + str.tostring(priceChg, "#.##") + "\n" +
                             "CVD Delta: " + str.tostring(cvdChg, "#.#") + "\n" +
                             "Divergence Score: " + str.tostring(divScore, "#.#") + " / 100\n" +
                             "VWAP State: " + (close > VWAP_val ? "Above VWAP" : "Below VWAP") + "\n" +
                             "Structure: " + (msState.trendDir == 1 ? "Bullish" : msState.trendDir == -1 ? "Bearish" : "Neutral")
        [cGlyph, cSize] = f_get_score_glyph_and_size(divScore, ofBubbleScale)
        // Optional glow effect for strong divergence aligned with market structure
        if divScore >= 75.0 and ((isBullDiv and msState.trendDir == 1) or (not isBullDiv and msState.trendDir == -1))
            label.new(bar_index, divY, "◆", color=color.new(color.black, 100), textcolor=color.new(divCol, 70), style=label.style_none, size=size.large)
        label.new(bar_index, divY, "◆", color=color.new(color.black, 100), textcolor=divCol, style=label.style_none, size=cSize, tooltip=divTip)

    // 5. LEGACY TAGS (if user selects Legacy or Both)
    if showLegacy
        if deltaImbalanceUp
            label.new(bar_index, low - atr * 0.35, "Δ↑", color=color.new(color.black, 100), textcolor=color.new(u_bull, 20), style=label.style_label_up, size=size.tiny, tooltip="DELTA IMBALANCE (buy-side)\nΔ = " + str.tostring(barDelta, "#.#") + "  (" + str.tostring(deltaNorm, "#.#") + "x avg)")
        if deltaImbalanceDn
            label.new(bar_index, high + atr * 0.35, "Δ↓", color=color.new(color.black, 100), textcolor=color.new(u_bear, 20), style=label.style_label_down, size=size.tiny, tooltip="DELTA IMBALANCE (sell-side)\nΔ = " + str.tostring(barDelta, "#.#") + "  (" + str.tostring(deltaNorm, "#.#") + "x avg)")
        if absorption
            label.new(bar_index, na, "ABS", color=color.new(color.black, 100), textcolor=color.new(u_acc, 10), style=label.style_label_down, yloc=yloc.abovebar, size=size.tiny, tooltip="ABSORPTION\nHigh volume with delta ≈ 0 and a large wick.")
        bool legacyBullDiv = ofCvdDivMode == "Trigger Bar Only" ? (cvdBullDivergence and not cvdBullDivergence[1]) : cvdBullDivergence
        bool legacyBearDiv = ofCvdDivMode == "Trigger Bar Only" ? (cvdBearDivergence and not cvdBearDivergence[1]) : cvdBearDivergence
        if showCvdBubbles and legacyBullDiv
            label.new(bar_index, low - atr * 0.65, "CVD↗", color=color.new(color.black, 100), textcolor=color.new(u_bull, 10), style=label.style_label_up, size=size.tiny, tooltip="CVD/PRICE BULL DIVERGENCE\nPrice lower but cumulative buy-delta rising.")
        if showCvdBubbles and legacyBearDiv
            label.new(bar_index, high + atr * 0.65, "CVD↘", color=color.new(color.black, 100), textcolor=color.new(u_bear, 10), style=label.style_label_down, size=size.tiny, tooltip="CVD/PRICE BEAR DIVERGENCE\nPrice higher but cumulative buy-delta falling.")

    // 6. WICK-ABSORPTION BUBBLES (Tier 1: ±0.35 ATR)
    if showBubbles and upperAbsorb
        label.new(bar_index, high + atr * 0.35, "↓", color=color.new(color.black, 100), textcolor=color.new(c_delta_bear, 0), style=label.style_none, size=size.normal, tooltip="[ UPPER WICK ABSORPTION ]\nOffers defended at " + str.tostring(high, format.mintick) + ".\nWick: " + str.tostring(upperWick / atr, "#.##") + "x ATR\nrVol: " + str.tostring(rVol, "#.##") + "x\nClose: Lower half of bar\n" + (na(ibPoc) ? "" : "Intrabar volume POC: " + str.tostring(ibPoc, format.mintick)))
    if showBubbles and lowerAbsorb
        label.new(bar_index, low - atr * 0.35, "↑", color=color.new(color.black, 100), textcolor=color.new(c_delta_bull, 0), style=label.style_none, size=size.normal, tooltip="[ LOWER WICK ABSORPTION ]\nBids defended at " + str.tostring(low, format.mintick) + ".\nWick: " + str.tostring(lowerWick / atr, "#.##") + "x ATR\nrVol: " + str.tostring(rVol, "#.##") + "x\nClose: Upper half of bar\n" + (na(ibPoc) ? "" : "Intrabar volume POC: " + str.tostring(ibPoc, format.mintick)))


// Expose order-flow series to the data window for confirmation/inspection.
plot(enableOrderFlow ? barDelta : na, "OF Bar Delta", color=color.new(color.gray, 0), display=display.data_window)
plot(enableOrderFlow ? cvd : na, "OF Cumulative Delta", color=color.new(color.blue, 0), display=display.data_window)
plot(enableOrderFlow ? avgAbsDelta : na, "OF Avg |Delta|", color=color.new(color.gray, 0), display=display.data_window)
plot(enableOrderFlow ? (ibOK ? 1 : 0) : na, "OF Estimator (1=tick,0=proxy)", display=display.data_window)
// Intrabar footprint internals — also the fastest way to confirm the tick-rule path is
// actually live on this symbol/plan: if "OF Intrabars/Bar" reads 0 or 1, the delta above is
// the range proxy no matter what the toggle says.
plot(enableOrderFlow ? ibCount : na, "OF Intrabars/Bar", color=color.new(color.gray, 0), display=display.data_window)
plot(enableOrderFlow and ibOK ? ibBuyV : na, "OF Intrabar Buy Vol", color=color.new(color.green, 0), display=display.data_window)
plot(enableOrderFlow and ibOK ? ibSellV : na, "OF Intrabar Sell Vol", color=color.new(color.red, 0), display=display.data_window)
plot(enableOrderFlow ? ibImbRatio : na, "OF Imbalance Ratio", color=color.new(color.gray, 0), display=display.data_window)
plot(enableOrderFlow ? ibPoc : na, "OF Intrabar POC", color=color.new(color.gray, 0), display=display.data_window)


// RPD DASHBOARD
// (Logic moved to end of script)
var table dashboard = na


// (Duplicate barsSinceSignal/lastSignal assignment removed — handled once in the signal engine.)


// HYBRID SMC MAIN EXECUTION


if enableHybridSMC
    inRangeCache := not dateFilterActive or time >= startTime
    
    float ph_smc = ta.pivothigh(high, inSwingLen, inSwingLen)
    float pl_smc = ta.pivotlow(low, inSwingLen, inSwingLen)
    
    if not na(ph_smc)
        msState.lastHighPrice := ph_smc
        msState.lastHighIndex := bar_index - inSwingLen
    
    if not na(pl_smc)
        msState.lastLowPrice := pl_smc
        msState.lastLowIndex := bar_index - inSwingLen
    
    bool crossOverHigh = not na(msState.lastHighPrice) and close > msState.lastHighPrice
    bool crossUnderLow = not na(msState.lastLowPrice) and close < msState.lastLowPrice
    
    if crossOverHigh and msState.trendDir != 1 and barConfirmed
        msState.trendDir := 1
        msState.trendStartBar := bar_index

        if inShowChoch
            if showChochLine
                draw_choch_line(msState.lastHighIndex, msState.lastHighPrice,
                               bar_index, msState.lastHighPrice, colChochBull)
            draw_choch_label(int(math.avg(msState.lastHighIndex, bar_index)),
                            msState.lastHighPrice, true, colChochBull)

        if inShowOb
            msState.findOrderBlock(true)

    else if crossOverHigh and msState.trendDir == 1 and inShowOb and barConfirmed
        msState.findOrderBlock(true)

    if crossUnderLow and msState.trendDir != -1 and barConfirmed
        msState.trendDir := -1
        msState.trendStartBar := bar_index

        if inShowChoch
            if showChochLine
                draw_choch_line(msState.lastLowIndex, msState.lastLowPrice,
                               bar_index, msState.lastLowPrice, colChochBear)
            draw_choch_label(int(math.avg(msState.lastLowIndex, bar_index)),
                            msState.lastLowPrice, false, colChochBear)

        if inShowOb
            msState.findOrderBlock(false)

    else if crossUnderLow and msState.trendDir == -1 and inShowOb and barConfirmed
        msState.findOrderBlock(false)

    float volMA = ta.sma(volume, inVolLen)
    [gapValid, gapBull, gapTop, gapBot, gapTypeStr] = msState.analyzeGap(volMA, inVolMult, inTrendMat, inGapMin)

    if gapValid and inRangeCache and barConfirmed and showGapTaxonomy
        color cBase = gapTypeStr == "Breakaway" ? colBreak : 
                      (gapTypeStr == "Runaway" ? colRun : colExhaust)
        string t = gapTypeStr == "Breakaway" ? "BREAKAWAY" : 
                   (gapTypeStr == "Runaway" ? "RUNAWAY" : "EXHAUSTION")
        
        // Professional Design: High Transparency + Subtle Border + Clean Text
        color cBg     = color.new(cBase, 90) // 90% Transparent (Glass effect)
        color cBorder = color.new(cBase, 60) // Subtle border definition
        
        // Tooltip Switch
        string gapTip = ""
        if gapTypeStr == "Breakaway"
            gapTip := "BREAKAWAY GAP\n\nConcept:\nOccurs at the start of a new trend, breaking structure.\n\nStrategy:\n• Strongest confirmation gap\n• Price rarely fills this gap quickly"
        else if gapTypeStr == "Runaway"
            gapTip := "RUNAWAY GAP\n\nConcept:\nOccurs in the middle of a trend, measuring continuation.\n\nStrategy:\n• Indicates trend strength\n• Often acts as support/resistance for continuation"
        else
            gapTip := "EXHAUSTION GAP\n\nConcept:\nOccurs at the end of a trend, signaling potential reversal.\n\nStrategy:\n• Warning sign: Do not chase the trend\n• Look for reversal patterns"
            
        box b = box.new(bar_index[2], gapTop, bar_index + inGapExt, gapBot, 
             bgcolor=cBg, border_color=cBorder, border_width=1, border_style=line.style_solid)
             
        label gapLbl = label.new(bar_index + inGapExt, (gapTop + gapBot) / 2, t, xloc=xloc.bar_index,
             color=color.new(color.white, 100), style=label.style_label_left,
             textcolor=color.new(color.white, 30), size=size.tiny, tooltip=gapTip)
        
        float mid = (gapTop + gapBot) * 0.5
        line l = line.new(bar_index[2], mid, bar_index + inGapExt, mid, 
             color=color.new(cBase, 80), style=line.style_dotted)
             
        array.push(gapBoxes, b)
        array.push(gapLines, l)
        array.push(gapLevels, mid)
        array.push(gapIsBull, gapBull)
        array.push(gapLabels, gapLbl)
    
    // Cleanup & Management
    int gapSize = array.size(gapBoxes)
    if gapSize > 0
        for i = gapSize - 1 to 0
            float lvl = array.get(gapLevels, i)
            bool isB = array.get(gapIsBull, i)
            
            bool mitigated = (isB and low <= lvl) or (not isB and high >= lvl)
                
            if mitigated
                box.delete(array.get(gapBoxes, i))
                line.delete(array.get(gapLines, i))
                label.delete(array.get(gapLabels, i))
                array.remove(gapBoxes, i)
                array.remove(gapLines, i)
                array.remove(gapLevels, i)
                array.remove(gapIsBull, i)
                array.remove(gapLabels, i)
    
    int obSize = array.size(activeOrderBlocks)
    if obSize > 0
        for i = obSize - 1 to 0
            OrderBlock ob = array.get(activeOrderBlocks, i)
            bool broken = (ob.isBullish and low < ob.bottom) or (not ob.isBullish and high > ob.top)
    
            if broken
                box.delete(ob.id)
                array.remove(activeOrderBlocks, i)
            else if barstate.islast
                box.set_right(ob.id, bar_index + regObRightOffset)

                // Context-Based Rendering: Hide if far from price
                // Check if Top OR Bottom is visible within 8 ATRs
                bool isVisibleOB = isVisible(ob.top, 8.0) or isVisible(ob.bottom, 8.0)

                if isVisibleOB
                    // Restore Transparency
                    color bg = ob.isBullish ? colBullOb : colBearOb
                    box.set_bgcolor(ob.id, color.new(bg, obTransparency))
                else
                    // Hide (Make transparent)
                    box.set_bgcolor(ob.id, color.new(color.gray, 100))
                    box.set_border_color(ob.id, color.new(color.gray, 100))

// Calculate exhaustion conditions for plotshape (must be outside conditional block)
bool buyExhaustionPlot = false
bool sellExhaustionPlot = false
if enableHybridSMC
    bool isHighStress = calc_stress(inLenStats, inThreshSigma)
    float trendBase = ta.ema(close, inLenTrend)
    
    // Base exhaustion conditions
    bool buyExhaustionBase = isHighStress and close > trendBase and close > open and inRangeCache
    bool sellExhaustionBase = isHighStress and close < trendBase and close < open and inRangeCache
    
    // Apply entropy filter
    // If filter is disabled OR RPD is disabled, always pass
    // Otherwise, check if entropy is below threshold
    bool entropyOK = true
    if useEntropyFilter and enableRPD
        entropyOK := entropy <= maxEntropy
        // Debug: If entropy filter blocks, signal won't appear
    
    // Apply volume filter
    // Calculate HybridSMC volume spike (always available as fallback)
    float volMA_smc = ta.sma(volume, inVolLen)
    bool volSpike_smc = volume > volSpikeMult * volMA_smc
    
    // Use RPD volume spike if RPD is enabled, otherwise use HybridSMC calculation
    bool volumeSpikeDetected = enableRPD ? volSpike : volSpike_smc
    
    // Volume filter: if disabled, always pass; otherwise require spike
    bool volumeOK = true
    if requireVolumeSpike
        volumeOK := volumeSpikeDetected
        // Debug: If volume filter blocks, signal won't appear
    
    // Apply minimum distance filter
    bool distanceOK = na(lastExhaustionBar) or (bar_index - lastExhaustionBar) >= minBarsBetweenExhaustion
    
    // Combine all filters - ALL must pass for signal to appear (matching REG-ORIGINAL.pine timing)
    buyExhaustionPlot  := buyExhaustionBase  and entropyOK and volumeOK and distanceOK
    sellExhaustionPlot := sellExhaustionBase and entropyOK and volumeOK and distanceOK
    
    // Update last exhaustion bar if signal triggered
    if buyExhaustionPlot or sellExhaustionPlot
        lastExhaustionBar := bar_index

// Replaced plotshape with label.new to support tooltips (Tier 3: ±1.05 ATR)
if barConfirmed and buyExhaustionPlot
    label.new(bar_index, high + atr * 1.05, "BE", color=color.red, textcolor=color.white, style=label.style_label_down, yloc=yloc.price, size=size.small, tooltip="BUYER EXHAUSTION (BE)\n" + "Concept: Price is statically overextended (> 2.0 Sigma).\n" + "Strategy: Buyers losing momentum. Look for SHORT setups.")
    f_ledgerRecord("EXH_Buy", close, -1, high)

if barConfirmed and sellExhaustionPlot
    label.new(bar_index, low - atr * 1.05, "SE", color=color.green, textcolor=color.white, style=label.style_label_up, yloc=yloc.price, size=size.small, tooltip="SELLER EXHAUSTION (SE)\n" + "Concept: Price is statistically overextended (> 2.0 Sigma).\n" + "Strategy: Sellers losing momentum. Look for LONG setups.")
    f_ledgerRecord("EXH_Sell", close, 1, low)



// LIQUIDITY ZONE DETECTION & PROCESSING


if enableLiquidity
    // Cleanup routine every 20 bars
    if bar_index % 20 == 0
        f_cleanupLiq(levelsH)
        f_cleanupLiq(levelsL)
    
    // Detect pivot highs and lows for liquidity zones
    float phLiq = ta.pivothigh(high, pivotLenLiq, pivotLenLiq)
    float plLiq = ta.pivotlow(low, pivotLenLiq, pivotLenLiq)
    
    // Create Bear Zone (Resistance/Supply)
    if not na(phLiq)
        bool alreadyExists = false
        if array.size(levelsH) > 0
            for i = 0 to array.size(levelsH) - 1
                LiquidityLevel existing = array.get(levelsH, i)
                if existing.active and math.abs(existing.price - phLiq) < (atrValLiq * 0.5)
                    alreadyExists := true
                    break
        
        if not alreadyExists
            array.push(levelsH, f_createLiqZone(phLiq, bar_index - pivotLenLiq, true))
    
    // Create Bull Zone (Support/Demand)
    if not na(plLiq)
        bool alreadyExists = false
        if array.size(levelsL) > 0
            for i = 0 to array.size(levelsL) - 1
                LiquidityLevel existing = array.get(levelsL, i)
                if existing.active and math.abs(existing.price - plLiq) < (atrValLiq * 0.5)
                    alreadyExists := true
                    break
                    
        if not alreadyExists
            array.push(levelsL, f_createLiqZone(plLiq, bar_index - pivotLenLiq, false))
    
    // Process Bear Sweeps (liquidity grabs above resistance)
    for lvl in levelsH
        if lvl.active
            // Mitigation: close above level invalidates the zone
            if close > lvl.price
                lvl.active := false
                box.set_right(lvl.bx, bar_index)
                line.set_x2(lvl.liqLine, bar_index)
                if not optimizeForScalping
                    box.set_bgcolor(lvl.bx, mitigateBg)
                    line.set_color(lvl.liqLine, na)
            else if barstate.islast
                box.set_right(lvl.bx, bar_index)
                line.set_x2(lvl.liqLine, bar_index)

                // Smart Rendering: Visibility Check
                bool isVis = isVisible(lvl.price, 10.0) // 10 ATR range
                if not isVis
                    // Hide if far away
                    box.set_bgcolor(lvl.bx, color.new(bearZoneBg, 100))
                    line.set_color(lvl.liqLine, na)
                else
                    // Show if close
                    // "Collapsed" Logic for Scalping: If old (> 100 bars) and optimized, hide box, keep line
                    bool isOld = (bar_index - lvl.createdBar) > 100
                    if optimizeForScalping and isOld
                        box.set_bgcolor(lvl.bx, color.new(bearZoneBg, 100)) // Hide box
                        line.set_color(lvl.liqLine, liqLineCol) // Keep line
                    else
                        box.set_bgcolor(lvl.bx, color.new(bearZoneBg, liqZoneTrans))
                        line.set_color(lvl.liqLine, showLIQLine ? liqLineCol : na)
            
            // Detect sweep: high pierces level but close stays below (Tier 2: ±0.65 ATR)
            bool bearSweepHit = high > lvl.price and close < lvl.price and showBearSweep
            bool bearSweepCooldownOK = (bar_index - lvl.lastSweepBar) >= sweepCooldownBars
            if bearSweepHit and bearSweepCooldownOK and barConfirmed
                float targetY = high + (atrValLiq * 0.65)
                bool isExternal = (bar_index - lvl.createdBar) > 50
                color sweepCol = isExternal ? color.rgb(255, 214, 0) : color.rgb(170, 0, 255) // Yellow = External, Purple = Internal
                string sweepTip = "[ INSTITUTIONAL LIQUIDITY SWEEP ]\n" +
                                  "Scope: " + (isExternal ? "External Liquidity Grab (Major High)" : "Internal Liquidity Grab (Minor High)") + "\n" +
                                  "Level Swept: " + str.tostring(lvl.price, "#.##") + "\n" +
                                  "High of Sweep: " + str.tostring(high, "#.##") + "\n" +
                                  "Close: " + str.tostring(close, "#.##") + "\n" +
                                  "Relative Vol: " + str.tostring(rVol, "#.##") + "x\n" +
                                  "VWAP: " + (close > VWAP_val ? "Above" : "Below") + "\n" +
                                  "Interpretation: Rejection at liquidity pool — sellers defending resistance."
                label.new(bar_index, targetY, "○", color=color.new(color.black, 100), textcolor=sweepCol, style=label.style_none, size=f_get_size(sweepLabelSize), tooltip=sweepTip)
                lvl.lastSweepBar := bar_index
                f_ledgerRecord("LIQ_Bear", close, -1, high)
    
    // Process Bull Sweeps (liquidity grabs below support)
    for lvl in levelsL
        if lvl.active
            // Mitigation: close below level invalidates the zone
            if close < lvl.price
                lvl.active := false
                box.set_right(lvl.bx, bar_index)
                line.set_x2(lvl.liqLine, bar_index)
                if not optimizeForScalping
                    box.set_bgcolor(lvl.bx, mitigateBg)
                    line.set_color(lvl.liqLine, na)
            else if barstate.islast
                box.set_right(lvl.bx, bar_index)
                line.set_x2(lvl.liqLine, bar_index)

                // Smart Rendering: Visibility Check
                bool isVis = isVisible(lvl.price, 10.0)
                if not isVis
                    box.set_bgcolor(lvl.bx, color.new(bullZoneBg, 100))
                    line.set_color(lvl.liqLine, na)
                else
                    bool isOld = (bar_index - lvl.createdBar) > 100
                    if optimizeForScalping and isOld
                        box.set_bgcolor(lvl.bx, color.new(bullZoneBg, 100))
                        line.set_color(lvl.liqLine, liqLineCol)
                    else
                        box.set_bgcolor(lvl.bx, color.new(bullZoneBg, liqZoneTrans))
                        line.set_color(lvl.liqLine, showLIQLine ? liqLineCol : na)
            
            // Detect sweep: low pierces level but close stays above (Tier 2: ±0.65 ATR)
            bool bullSweepHit = low < lvl.price and close > lvl.price and showBullSweep
            bool bullSweepCooldownOK = (bar_index - lvl.lastSweepBar) >= sweepCooldownBars
            if bullSweepHit and bullSweepCooldownOK and barConfirmed
                float targetY = low - (atrValLiq * 0.65)
                bool isExternal = (bar_index - lvl.createdBar) > 50
                color sweepCol = isExternal ? color.rgb(255, 214, 0) : color.rgb(170, 0, 255) // Yellow = External, Purple = Internal
                string sweepTip = "[ INSTITUTIONAL LIQUIDITY SWEEP ]\n" +
                                  "Scope: " + (isExternal ? "External Liquidity Grab (Major Low)" : "Internal Liquidity Grab (Minor Low)") + "\n" +
                                  "Level Swept: " + str.tostring(lvl.price, "#.##") + "\n" +
                                  "Low of Sweep: " + str.tostring(low, "#.##") + "\n" +
                                  "Close: " + str.tostring(close, "#.##") + "\n" +
                                  "Relative Vol: " + str.tostring(rVol, "#.##") + "x\n" +
                                  "VWAP: " + (close > VWAP_val ? "Above" : "Below") + "\n" +
                                  "Interpretation: Absorption at liquidity pool — buyers defending support."
                label.new(bar_index, targetY, "○", color=color.new(color.black, 100), textcolor=sweepCol, style=label.style_none, size=f_get_size(sweepLabelSize), tooltip=sweepTip)
                lvl.lastSweepBar := bar_index
                f_ledgerRecord("LIQ_Bull", close, 1, low)


// PLOT STATISTICS


int activeLiqZones = 0
if enableLiquidity
    for lvl in levelsH
        if lvl.active
            activeLiqZones += 1
    for lvl in levelsL
        if lvl.active
            activeLiqZones += 1

plot(activeLiqZones, "Active Liquidity Zones", color=color.new(color.blue, 80), display=display.data_window)

int activeCount = 0
if enableFVG and activeSetups.size() > 0
    for s in activeSetups
        if s.isActive
            activeCount += 1

plot(activeCount, "Active FVG Setups", color=color.new(color.gray, 80), display=display.data_window)

// Periodic Cleanup for Liquidity arrays
if barstate.isconfirmed
    f_cleanupLiq(levelsH)
    f_cleanupLiq(levelsL)



// REGRESSION LOGIC & OB DETECTION

// Initialize Plot Flags (Global Scope compliance)
bool plotBullOB = false
bool plotBearOB = false
int regObLookback = regObPeriods + 1

// 1. Regression Channel Calculation (O(1) Optimized)
// Calculate if explicitly enabled OR if dashboard needs it
if enableRegOB or (enableRPD and show_dashboard)
    [regSlope, regAvg, regIntercept] = calcSlope(close, regLength)
    
    // Only calculate Draw logic on last bar
    // Fix: regIntercept is the value at the Start (Left) of the window
    regStartPrice = regIntercept 
    regEndPrice = regIntercept + regSlope * (regLength - 1)
    
    // Calculate Stats on EVERY bar (O(1))
    [regStdDev, rP] = calcRegStats(close, regLength)
    regPearson := rP
    
    // Initialize Bounds variables
    float regUpDev = 0.0
    float regDnDev = 0.0

    // Draw Channel (Only if enableRegOB is true)
    if enableRegOB and barstate.islast
        // Calculate expensive bounds only on last bar
        [u, d] = calcRegBounds(close, regLength, regSlope, regIntercept)
        regUpDev := u
        regDnDev := d
        
        // Calculate Channel Levels
        regUpperStart = regStartPrice + (regUseUpper ? regUpperMult * regStdDev : regUpDev)
        regUpperEnd   = regEndPrice   + (regUseUpper ? regUpperMult * regStdDev : regUpDev)
        regLowerStart = regStartPrice + (regUseLower ? -regLowerMult * regStdDev : -regDnDev)
        regLowerEnd   = regEndPrice   + (regUseLower ? -regLowerMult * regStdDev : -regDnDev)
    
        // Update Lines
        line.delete(regBaseLine)
        line.delete(regUpperLine)
        line.delete(regLowerLine)
        
        regBaseLine := line.new(bar_index - regLength + 1, regStartPrice, bar_index, regEndPrice, 
             width=1, color= regShowBaseLine ? color.new(regBearColor, 0) : na)
             
        // lineFill will use later     
        if regUseUpper
            regUpperLine := line.new(bar_index - regLength + 1, regUpperStart, bar_index, regUpperEnd, 
                 width=1, color=color.new(regBullColor, 0))
            // linefill.new(regUpperLine, regBaseLine, color=color.new(regBullColor, 90))
                 
        if regUseLower
            regLowerLine := line.new(bar_index - regLength + 1, regLowerStart, bar_index, regLowerEnd, 
                 width=1, color=color.new(regBullColor, 0))
            // linefill.new(regBaseLine, regLowerLine, color=color.new(regBearColor, 90))
    
        // Pearson Label (Offset to Right)
        if regShowPearson
            label.delete(regPearsonLabel)
            regPearsonLabel := label.new(bar_index + 12, regUpperEnd, 
                 "Pearson's R: " + str.tostring(regPearson, "#.##"), 
                 color=color.new(color.black, 100), textcolor=c_text_primary, style=label.style_label_left)
    
    // 2. Trend Determination
    regTrendDir := math.sign(regEndPrice - regStartPrice)
    regTrendText = regTrendDir > 0 ? "UPTREND" : regTrendDir < 0 ? "DOWNTREND" : "NEUTRAL"
    
    if barstate.islast and regShowTrend
        label.delete(regTrendLabel)
        regColor = regTrendDir > 0 ? color.green : regTrendDir < 0 ? color.red : color.gray
        // Move Trend Label to Right (Align with Base/Mid Line)
        regTrendLabel := label.new(bar_index + 12, regEndPrice, "Trend: " + regTrendText, color=regColor, textcolor=color.white, style=label.style_label_left)
    
    
    // 3. Order Block Detection (Zero-Delay + Legacy dual mode)
    float regObBullSize = 0.0
    float regObBearSize = 0.0
    
    // Scalping Optimization: Skip OB detection if optimizing
    if enableRegOB and regEarlyDetect and not optimizeForScalping
        // ═══════════════════════════════════════════════════
        // ZERO-DELAY MODE: detect OB source at bar_index-1
        // ═══════════════════════════════════════════════════
        bool srcIsBearCandle = close[1] < open[1]
        bool srcIsBullCandle = close[1] > open[1]
        [bullSizeOK, bullObSize] = f_regObSizeCheck(true, 1)
        [bearSizeOK, bearObSize] = f_regObSizeCheck(false, 1)
        
        // Detect new OB source candles (bar[1] just closed)
        float obDedupeTol = atr * regDedupeAtr
        if barstate.isconfirmed and srcIsBearCandle and bullSizeOK
            float obTop = regUseWicks ? high[1] : open[1]
            float obBot = regUseWicks ? low[1]  : math.min(open[1], close[1])
            bool dupBull = not na(lastBullObTop) and math.abs(obTop - lastBullObTop) <= obDedupeTol and math.abs(obBot - lastBullObBot) <= obDedupeTol
            if not dupBull
                lastBullObTop := obTop
                lastBullObBot := obBot
                array.push(regPendingOBs, f_processRegOB(true, bar_index - 1, obTop, obBot, bullObSize, 0.0, regBullColor, 0, false))

        if barstate.isconfirmed and srcIsBullCandle and bearSizeOK
            float obTop = regUseWicks ? high[1] : math.max(open[1], close[1])
            float obBot = regUseWicks ? low[1]  : open[1]
            bool dupBear = not na(lastBearObTop) and math.abs(obTop - lastBearObTop) <= obDedupeTol and math.abs(obBot - lastBearObBot) <= obDedupeTol
            if not dupBear
                lastBearObTop := obTop
                lastBearObBot := obBot
                array.push(regPendingOBs, f_processRegOB(false, bar_index - 1, obTop, obBot, bearObSize, 0.0, regBearColor, 0, false))
        
        // Progressive confirmation of pending OBs
        if barConfirmed and array.size(regPendingOBs) > 0
            for i = array.size(regPendingOBs) - 1 to 0
                RegOB pob = array.get(regPendingOBs, i)
                if not pob.active
                    array.remove(regPendingOBs, i)
                    continue
                int barsSinceSource = bar_index - pob.startIndex
                // Expire stale pending OBs that never got enough confirms
                if barsSinceSource > regObPeriods + 2
                    line.delete(pob.highLine)
                    line.delete(pob.lowLine)
                    box.delete(pob.zoneBox)
                    array.remove(regPendingOBs, i)
                    continue
                bool isConfirming = pob.isBull ? (close > open) : (close < open)
                if isConfirming and barsSinceSource <= regObPeriods
                    pob.confirmCount += 1
                    bool nowConfirmed = pob.confirmCount >= regObPeriods
                    if nowConfirmed
                        pob.isConfirmed := true
                        color c = pob.isBull ? regBullColor : regBearColor
                        line.set_color(pob.highLine, na)
                        line.set_style(pob.highLine, line.style_solid)
                        line.set_color(pob.lowLine, na)
                        line.set_style(pob.lowLine, line.style_solid)
                        box.set_bgcolor(pob.zoneBox, color.new(c, 90))
                        box.set_border_color(pob.zoneBox, na)
                        box.set_border_style(pob.zoneBox, line.style_solid)
                        array.push(regOBs, pob)
                        array.remove(regPendingOBs, i)
                        regFoundBull := pob.isBull
                        regFoundBear := not pob.isBull
                        // Phase 2 ledger: Reg OB confirmed (zero-delay).
                        float obStop = pob.isBull ? box.get_bottom(pob.zoneBox) : box.get_top(pob.zoneBox)
                        f_ledgerRecord(pob.isBull ? "RegOB_Bull" : "RegOB_Bear", close, pob.isBull ? 1 : -1, obStop)
                        // Alert (Only if Trend aligns)
                        if regAlertOnOb and ((pob.isBull and regTrendDir > 0) or (not pob.isBull and regTrendDir < 0))
                            alert((pob.isBull ? "Bullish" : "Bearish") + " Reg OB Detected (Zero-Delay)", alert.freq_once_per_bar)
                    else
                        // Still pending: the only remaining pending/confirmed distinction is
                        // the box transparency (92 vs 90), since the stage label is gone.
                        color c = pob.isBull ? regBullColor : regBearColor
                        box.set_bgcolor(pob.zoneBox, color.new(c, 92))
                        box.set_border_color(pob.zoneBox, na)
                else if not isConfirming and barsSinceSource <= regObPeriods and barstate.isconfirmed
                    // A non-confirming bar inside the window invalidates the pending OB
                    line.delete(pob.highLine)
                    line.delete(pob.lowLine)
                    box.delete(pob.zoneBox)
                    pob.active := false
                    array.remove(regPendingOBs, i)

        // Extend pending OB lines
        if regExtendLines and array.size(regPendingOBs) > 0
            for i = 0 to array.size(regPendingOBs) - 1
                RegOB pob = array.get(regPendingOBs, i)
                line.set_x2(pob.highLine, bar_index + regObRightOffset)
                line.set_x2(pob.lowLine, bar_index + regObRightOffset)
                box.set_right(pob.zoneBox, bar_index + regObRightOffset)
    
    else if enableRegOB and not optimizeForScalping
        // ═══════════════════════════════════════════════════
        // LEGACY MODE: lookback-based detection (6-bar delay)
        // ═══════════════════════════════════════════════════
        regAbsMove = math.abs(close[regObLookback] - close[1])/close[regObLookback] * 100
        regRelMove = regAbsMove >= regThreshold
        
        // Bullish OB
        regIsBullOb = close[regObLookback] < open[regObLookback]
        regBullCounts = 0
        for k = 1 to regObPeriods
            regBullCounts += (close[k] > open[k] ? 1 : 0)
        
        if regIsBullOb
            h = regUseWicks ? high[regObLookback] : open[regObLookback]
            l = low[regObLookback]
            regObBullSize := (h - l) / l * 100
        
        regSizeFilterBull = regObBullSize >= regMinObSize and regObBullSize <= regMaxObSize
        regAtrFilterBull = not regUseAtrFilter or ((high[regObLookback] - low[regObLookback]) <= atrValLiq * regAtrMult)
        
        regFoundBull := regIsBullOb and (regBullCounts == regObPeriods) and regRelMove and regSizeFilterBull and regAtrFilterBull
        
        // Bearish OB
        regIsBearOb = close[regObLookback] > open[regObLookback]
        regBearCounts = 0
        for m = 1 to regObPeriods
            regBearCounts += (close[m] < open[m] ? 1 : 0)
        
        if regIsBearOb
            h = high[regObLookback]
            l = regUseWicks ? low[regObLookback] : open[regObLookback]
            regObBearSize := (h - l) / l * 100
        
        regSizeFilterBear = regObBearSize >= regMinObSize and regObBearSize <= regMaxObSize
        regAtrFilterBear = not regUseAtrFilter or ((high[regObLookback] - low[regObLookback]) <= atrValLiq * regAtrMult)
        
        regFoundBear := regIsBearOb and (regBearCounts == regObPeriods) and regRelMove and regSizeFilterBear and regAtrFilterBear
        
        // Storing and Drawing OBs (Alert only on Trend)
        // Same dedupe as zero-delay mode: suppress a zone that lands on top of the last
        // one in the same direction, so a run of qualifying bars yields one OB not eight.
        float obDedupeTolLegacy = atr * regDedupeAtr
        if regFoundBull and barConfirmed
            obTop = regUseWicks ? high[regObLookback] : open[regObLookback]
            obBot = low[regObLookback]
            obIdx = bar_index - regObLookback
            bool dupBull = not na(lastBullObTop) and math.abs(obTop - lastBullObTop) <= obDedupeTolLegacy and math.abs(obBot - lastBullObBot) <= obDedupeTolLegacy
            if not dupBull
                lastBullObTop := obTop
                lastBullObBot := obBot
                newOb = f_processRegOB(true, obIdx, obTop, obBot, regObBullSize, regAbsMove, regBullColor, regObPeriods, true)
                array.push(regOBs, newOb)
                f_ledgerRecord("RegOB_Bull", close, 1, obBot)
                if regAlertOnOb and regTrendDir > 0
                    alert("Bullish Reg OB Detected", alert.freq_once_per_bar)

        if regFoundBear and barConfirmed
            obTop = high[regObLookback]
            obBot = regUseWicks ? low[regObLookback] : open[regObLookback]
            obIdx = bar_index - regObLookback
            bool dupBear = not na(lastBearObTop) and math.abs(obTop - lastBearObTop) <= obDedupeTolLegacy and math.abs(obBot - lastBearObBot) <= obDedupeTolLegacy
            if not dupBear
                lastBearObTop := obTop
                lastBearObBot := obBot
                newOb = f_processRegOB(false, obIdx, obTop, obBot, regObBearSize, regAbsMove, regBearColor, regObPeriods, true)
                array.push(regOBs, newOb)
                f_ledgerRecord("RegOB_Bear", close, -1, obTop)
                if regAlertOnOb and regTrendDir < 0
                    alert("Bearish Reg OB Detected", alert.freq_once_per_bar)
    
    // Shapes visuals - Set flags for global plotshape
    if enableRegOB
        plotBullOB := regFoundBull
        plotBearOB := regFoundBear
    



    // 5. Cleanup / Update Lines
    if array.size(regOBs) > 0
        // Mitigation Check (Remove invalid OBs) + distance cull.
        // The cull runs independently of regRemoveMitigated: a bear OB above price can
        // only be mitigated by a close above it, so an OB 700 points overhead is never
        // invalidated and stays drawn indefinitely.
        if regRemoveMitigated or cullFarZones
            for i = array.size(regOBs) - 1 to 0
                ob = array.get(regOBs, i)
                bool mitigated = false
                if regRemoveMitigated
                    if ob.isBull
                        val = line.get_y1(ob.lowLine)
                        if close < val
                            mitigated := true
                    else
                        val = line.get_y1(ob.highLine)
                        if close > val
                            mitigated := true

                if not mitigated and cullFarZones
                    float obMid = (line.get_y1(ob.highLine) + line.get_y1(ob.lowLine)) / 2.0
                    if not isVisible(obMid, maxZoneDistAtr)
                        mitigated := true

                if mitigated
                    line.delete(ob.highLine)
                    line.delete(ob.lowLine)
                    box.delete(ob.zoneBox)
                    array.remove(regOBs, i)

        // Source logic "Show All" toggle: Remove oldest until we have 2 left if disabled
        if not regShowAll and array.size(regOBs) > 2
            for i = 1 to (array.size(regOBs) - 2)
                old = array.shift(regOBs)
                line.delete(old.highLine)
                line.delete(old.lowLine)
                box.delete(old.zoneBox)

        // Global max limit to prevent memory issues
        if array.size(regOBs) > 100
            for i = 1 to (array.size(regOBs) - 100)
                old = array.shift(regOBs)
                line.delete(old.highLine)
                line.delete(old.lowLine)
                box.delete(old.zoneBox)

        // Extend lines if option is on (legacy mode only; zero-delay extends inline)
        if regExtendLines and barstate.islast
            size = array.size(regOBs)
            if size > 0
                for i = 0 to size - 1
                    ob = array.get(regOBs, i)
                    line.set_x2(ob.highLine, bar_index + regObRightOffset)
                    line.set_x2(ob.lowLine, bar_index + regObRightOffset)
                    box.set_right(ob.zoneBox, bar_index + regObRightOffset)

// Global Barcolor Calls for Regression OB (Replacing triangles)
// Placed retrospectively on the OB start candle upon confirmation.
int regPlotOffset = regEarlyDetect ? -regObPeriods : -regObLookback
barcolor(plotBullOB ? u_bull : (plotBearOB ? u_bear : na), offset=regPlotOffset, title="Regression OB Barcolor")
plotshape(plotBullOB, style=shape.triangleup, location=location.belowbar, color=regBullColor, size=size.small, offset=regPlotOffset, title="Reg Bull OB Confirmed")
plotshape(plotBearOB, style=shape.triangledown, location=location.abovebar, color=regBearColor, size=size.small, offset=regPlotOffset, title="Reg Bear OB Confirmed")

// ════════════════════════════════════════════════════════════════════════════════
// RPD DASHBOARD (Glassmorphism Card & Compact HUD Modes)
// ════════════════════════════════════════════════════════════════════════════════

if (not show_dashboard or dashboard_mode == "Off") and not na(dashboard)
    table.delete(dashboard)
    dashboard := na

if enableRPD and show_dashboard and dashboard_mode != "Off" and barstate.islast and (barConfirmed or na(dashboard))
    dashboard_pos = dashboard_position_input == "Top Left" ? position.top_left : dashboard_position_input == "Top Right" ? position.top_right : dashboard_position_input == "Bottom Left" ? position.bottom_left : position.bottom_right
    
    // Core calculation
    float rawScore = math.max(nz(peakProb, lastPeakProb), nz(valleyProb, lastValleyProb))
    string activeSigType = lastSignalType == "Peak" ? "RPD_Peak" : lastSignalType == "Valley" ? "RPD_Valley" : "RPD_Peak"
    [calStatProb, calStatN] = f_calStats(activeSigType)
    bool calibrationWarm = useCalibratedProb and calStatN < minCalSamples
    float calibratedScore = useCalibratedProb and not calibrationWarm ? calStatProb : rawScore
    float totalScore = calibratedScore
    string probBasis = useCalibratedProb and not calibrationWarm ? "rolling hit n=" + str.tostring(calStatN) : useCalibratedProb ? "heuristic; hit estimate warming n=" + str.tostring(calStatN) : "heuristic"
    bool empiricalScoreActive = useCalibratedProb and not calibrationWarm
    signalQuality = empiricalScoreActive ? (totalScore >= 65 ? "EXCEPTIONAL" : totalScore >= 58 ? "STRONG" : totalScore >= 52 ? "MODERATE" : totalScore >= 45 ? "BUILDING" : "WEAK") : (totalScore >= 90 ? "EXCEPTIONAL" : totalScore >= 75 ? "STRONG" : totalScore >= 60 ? "MODERATE" : totalScore >= 30 ? "BUILDING" : "WEAK")
    scoreColor = signalQuality == "EXCEPTIONAL" ? #FFD700 : signalQuality == "STRONG" ? #26A69A : signalQuality == "MODERATE" ? bullColor : signalQuality == "BUILDING" ? #FF8C00 : #787B86
    if calibrationWarm
        scoreColor := #787B86   // WP-C2: unproven sample sizes render gray everywhere

    float dx = barDelta / _deltaScale
    color dxCol = deltaNorm < ofNeutralBand ? #787B86 : barDelta > 0 ? #26A69A : barDelta < 0 ? #EF5350 : #787B86
    string cvdSuffix = not cvdWindowClean ? " (est. switch " + str.tostring(barsSinceFlip) + "b)" : (cvdBullDivergence ? " ↗ div" : cvdBearDivergence ? " ↘ div" : "")
    color cvdCol = not cvdWindowClean ? #787B86 : cvdBullDivergence ? #26A69A : cvdBearDivergence ? #EF5350 : c_text_primary
    string ofState = upperAbsorb ? "SUPPLY ABSORB" : lowerAbsorb ? "DEMAND ABSORB" : absorption ? "ABSORPTION" : deltaImbalanceUp ? "BUY IMBALANCE" : deltaImbalanceDn ? "SELL IMBALANCE" : "balanced"
    color  ofCol   = upperAbsorb ? #EF5350 : lowerAbsorb ? #26A69A : absorption ? #FFD700 : deltaImbalanceUp ? #26A69A : deltaImbalanceDn ? #EF5350 : #787B86

    trendDirection = rTrend == 1 ? 1 : -1
    htfText = trendDirection > 0 ? "📈 BULL" : "📉 BEAR"
    htfColor = trendDirection > 0 ? #26A69A : #EF5350

    regTrendStr = regTrendDir > 0 ? "UP" : regTrendDir < 0 ? "DOWN" : "FLAT"
    regInfo = regTrendStr + " (R:" + str.tostring(regPearson, "#.##") + ")"
    regCol = regTrendDir > 0 ? #26A69A : regTrendDir < 0 ? #EF5350 : #787B86

    entropyText = entropy < effectiveEntropyThresh ? "LOW" : entropy < 0.8 ? "MED" : "HIGH"
    entropyColor = entropy < effectiveEntropyThresh ? #26A69A : entropy < 0.8 ? #FFD700 : #EF5350

    if dashboard_mode == "Compact HUD"
        if not na(dashboard)
            table.delete(dashboard)
        int hudCols = 6
        int hudRows = 2
        dashboard := table.new(dashboard_pos, hudCols, hudRows, border_width = 1, border_color = color.new(c_table_border, 30), bgcolor = color.new(c_table_bg, 15))
        
        // Row 0: Category Headers
        table.cell(dashboard, 0, 0, "🎯 RPD PROB", text_halign=text.align_center, text_color=c_text_secondary, bgcolor=color.new(c_table_header, 20), text_size=size.tiny)
        table.cell(dashboard, 1, 0, "🩸 ORDER FLOW", text_halign=text.align_center, text_color=c_text_secondary, bgcolor=color.new(c_table_header, 20), text_size=size.tiny)
        table.cell(dashboard, 2, 0, "📊 CVD DIV", text_halign=text.align_center, text_color=c_text_secondary, bgcolor=color.new(c_table_header, 20), text_size=size.tiny)
        table.cell(dashboard, 3, 0, "🏗️ STRUCTURE", text_halign=text.align_center, text_color=c_text_secondary, bgcolor=color.new(c_table_header, 20), text_size=size.tiny)
        table.cell(dashboard, 4, 0, "📉 REG TREND", text_halign=text.align_center, text_color=c_text_secondary, bgcolor=color.new(c_table_header, 20), text_size=size.tiny)
        table.cell(dashboard, 5, 0, "⚡ ENTROPY", text_halign=text.align_center, text_color=c_text_secondary, bgcolor=color.new(c_table_header, 20), text_size=size.tiny)
        
        // Row 1: Live Status Pills
        string rpdPill = str.tostring(totalScore, "#.0") + (empiricalScoreActive ? "% " : "★ ") + (lastSignalType == "Peak" ? "▼" : lastSignalType == "Valley" ? "▲" : "—")
        string ofPill = (enableOrderFlow ? (str.tostring(barDelta, "#.#") + (barDelta > 0 ? " Δ↑" : " Δ↓")) : "OFF")
        string cvdPill = (enableOrderFlow ? (cvdBullDivergence ? "↗ Bull Div" : cvdBearDivergence ? "↘ Bear Div" : "Aligned") : "—")
        string msPill = htfText + " | " + (msState.trendDir == 1 ? "Bull" : msState.trendDir == -1 ? "Bear" : "Neut")
        string regPill = regTrendStr + " (" + str.tostring(regPearson, "#.##") + ")"
        string entPill = entropyText + " (" + str.tostring(entropy, "#.2") + ")"
        
        table.cell(dashboard, 0, 1, rpdPill, text_halign=text.align_center, text_color=scoreColor, bgcolor=color.new(c_table_row_alt, 10), text_size=size.tiny)
        table.cell(dashboard, 1, 1, ofPill, text_halign=text.align_center, text_color=dxCol, bgcolor=color.new(c_table_row_alt, 10), text_size=size.tiny)
        table.cell(dashboard, 2, 1, cvdPill, text_halign=text.align_center, text_color=cvdCol, bgcolor=color.new(c_table_row_alt, 10), text_size=size.tiny)
        table.cell(dashboard, 3, 1, msPill, text_halign=text.align_center, text_color=htfColor, bgcolor=color.new(c_table_row_alt, 10), text_size=size.tiny)
        table.cell(dashboard, 4, 1, regPill, text_halign=text.align_center, text_color=regCol, bgcolor=color.new(c_table_row_alt, 10), text_size=size.tiny)
        table.cell(dashboard, 5, 1, entPill, text_halign=text.align_center, text_color=entropyColor, bgcolor=color.new(c_table_row_alt, 10), text_size=size.tiny)

    else
        bool isMobile = dashboard_size == "Mobile"
        cols = 4
        int ledgerRows = 18
        rows = isMobile ? (17 + ledgerRows) : (dashboard_size == "Small" ? 8 : dashboard_size == "Normal" ? 34 : (28 + ledgerRows))
        
        if not na(dashboard)
            table.delete(dashboard)
        dashboard := table.new(dashboard_pos, cols, rows, border_width = 1, border_color = color.new(c_table_border, 40), bgcolor = color.new(c_table_bg, 20))
        
        // Colors from theme tokens
        dc_white   = c_text_primary
        dc_gray    = c_text_secondary
        dc_green   = #26A69A
        dc_red     = #EF5350
        dc_gold    = #FFD700
        dc_purple  = quantumColor
        dc_aqua    = bullColor
        dc_orange  = #FF8C00
        bg_header  = color.new(c_table_header, 10)
        bg_section = color.new(c_table_section, 20)
        bg_alt     = color.new(c_table_row_alt, 25)
        
        header_size = isMobile ? size.tiny : size.small
        value_size  = isMobile ? size.tiny : size.small
        label_size  = size.tiny
        
        current_row = 0
        
        // --- HEADER ---
        table.merge_cells(dashboard, 0, current_row, cols - 1, current_row)
        table.cell(dashboard, 0, current_row, "RPD INSTITUTIONAL | " + syminfo.ticker, text_halign=text.align_center, text_color=dc_white, bgcolor=bg_header, text_size=header_size)
        current_row += 1

        // --- SCORE ---
        if not isMobile
            table.merge_cells(dashboard, 0, current_row, cols - 1, current_row)
            table.cell(dashboard, 0, current_row, "═══ 🎯 CALIBRATED PROB SCORE ═══", text_halign=text.align_center, text_color=dc_gold, bgcolor=bg_section, text_size=label_size)
            current_row += 1

        table.cell(dashboard, 0, current_row, empiricalScoreActive ? "ROLLING HIT %" : "SCORE ★", text_color=dc_gray, text_size=label_size)
        table.merge_cells(dashboard, 1, current_row, cols - 1, current_row)
        table.cell(dashboard, 1, current_row, str.tostring(totalScore, "#.##") + (empiricalScoreActive ? "%" : "★") + " (" + probBasis + ")", text_halign=text.align_right, text_color=scoreColor, text_size=value_size)
        current_row += 1
        
        if not isMobile
            table.cell(dashboard, 0, current_row, "Quality", text_color=dc_gray, text_size=label_size)
            table.merge_cells(dashboard, 1, current_row, cols - 1, current_row)
            qualityEmoji = signalQuality == "EXCEPTIONAL" ? "🌟" : signalQuality == "STRONG" ? "💪" : signalQuality == "MODERATE" ? "👍" : "⚠️"
            table.cell(dashboard, 1, current_row, qualityEmoji + " " + signalQuality, text_halign=text.align_right, text_color=scoreColor, text_size=value_size)
            current_row += 1

        // --- ORDER FLOW & STRUCTURE ---
        if dashboard_size != "Small" 
            if not isMobile
                table.merge_cells(dashboard, 0, current_row, cols - 1, current_row)
                table.cell(dashboard, 0, current_row, "═══ 📊 ORDER FLOW ═══", text_halign=text.align_center, text_color=dc_gold, bgcolor=bg_section, text_size=label_size)
                current_row += 1

            table.cell(dashboard, 0, current_row, "Vol Spike", text_color=dc_gray, text_size=label_size)
            table.merge_cells(dashboard, 1, current_row, cols - 1, current_row)
            table.cell(dashboard, 1, current_row, (volSpike ? "YES" : "NO") + " (" + str.tostring(volRatio, "#.#") + "x)", text_halign=text.align_right, text_color=volSpike ? dc_green : dc_red, text_size=value_size)
            current_row += 1

            if enableOrderFlow
                table.cell(dashboard, 0, current_row, ibOK ? "Bar Δ (tick)" : "Bar Δ (proxy)", text_color=dc_gray, text_size=label_size)
                table.merge_cells(dashboard, 1, current_row, cols - 1, current_row)
                table.cell(dashboard, 1, current_row, str.tostring(barDelta, "#.#") + " (" + str.tostring(dx, "#.##") + "x" + (na(ibImbRatio) ? "" : ", " + str.tostring(ibImbRatio, "#.##") + ":1") + ")", text_halign=text.align_right, text_color=dxCol, text_size=label_size)
                current_row += 1
                table.cell(dashboard, 0, current_row, "CVD", text_color=dc_gray, text_size=label_size)
                table.merge_cells(dashboard, 1, current_row, cols - 1, current_row)
                table.cell(dashboard, 1, current_row, str.tostring(cvd, "#.#") + cvdSuffix, text_halign=text.align_right, text_color=cvdCol, text_size=label_size)
                current_row += 1
                table.cell(dashboard, 0, current_row, "OF State", text_color=dc_gray, text_size=label_size)
                table.merge_cells(dashboard, 1, current_row, cols - 1, current_row)
                table.cell(dashboard, 1, current_row, ofState, text_halign=text.align_right, text_color=ofCol, text_size=label_size)
                current_row += 1

            if not isMobile
                table.merge_cells(dashboard, 0, current_row, cols - 1, current_row)
                table.cell(dashboard, 0, current_row, "📊 Component Analysis", text_halign=text.align_center, text_color=dc_aqua, text_size=label_size)
                current_row += 1
                
            table.cell(dashboard, 0, current_row, "Pk Heur", text_color=dc_gray, text_size=label_size)
            peakColor = not na(peakProb) and peakProb > 70 ? dc_red : not na(peakProb) and peakProb > 40 ? dc_orange : dc_gray
            table.cell(dashboard, 1, current_row, not na(peakProb) ? str.tostring(peakProb, "#.#") : "—", text_halign=text.align_right, text_color=peakColor, text_size=label_size)

            table.cell(dashboard, 2, current_row, "Vy Heur", text_color=dc_gray, text_size=label_size)
            valleyColor = not na(valleyProb) and valleyProb > 70 ? dc_green : not na(valleyProb) and valleyProb > 40 ? dc_aqua : dc_gray
            table.cell(dashboard, 3, current_row, not na(valleyProb) ? str.tostring(valleyProb, "#.#") : "—", text_halign=text.align_right, text_color=valleyColor, text_size=label_size)
            current_row += 1

            if not isMobile
                table.merge_cells(dashboard, 0, current_row, cols - 1, current_row)
                table.cell(dashboard, 0, current_row, "═══ 🌌 MARKET STRUCTURE ═══", text_halign=text.align_center, text_color=dc_gold, bgcolor=bg_section, text_size=label_size)
                current_row += 1
                
            table.cell(dashboard, 0, current_row, "Trend", text_color=dc_gray, text_size=label_size)
            table.merge_cells(dashboard, 1, current_row, cols - 1, current_row)
            table.cell(dashboard, 1, current_row, htfText, text_halign=text.align_right, text_color=htfColor, text_size=value_size)
            current_row += 1
            
            table.cell(dashboard, 0, current_row, "Regression", text_color=dc_gray, text_size=label_size)
            table.merge_cells(dashboard, 1, current_row, cols-1, current_row)
            table.cell(dashboard, 1, current_row, regInfo, text_halign=text.align_right, text_color=regCol, text_size=value_size)
            current_row += 1
            
            table.cell(dashboard, 0, current_row, "Entropy", text_color=dc_gray, text_size=label_size)
            table.merge_cells(dashboard, 1, current_row, cols - 1, current_row)
            table.cell(dashboard, 1, current_row, entropyText, text_halign=text.align_right, text_color=entropyColor, text_size=value_size)
            current_row += 1

        // --- PREDICTIVES ---
        if dashboard_size == "Large" or isMobile
            if not isMobile and dashboard_size == "Large"
                table.merge_cells(dashboard, 0, current_row, cols - 1, current_row)
                table.cell(dashboard, 0, current_row, "═══ 🛡️ FILTERS ═══", text_halign=text.align_center, text_color=dc_gold, bgcolor=bg_section, text_size=label_size)
                current_row += 1
                
            table.cell(dashboard, 0, current_row, "RSI", text_color=dc_gray, text_size=label_size)
            rsiText = rsi > rsiTop ? "Overbought" : rsi < rsiBot ? "Oversold" : "Neutral"
            rsiColor = rsi > rsiTop ? dc_red : rsi < rsiBot ? dc_green : dc_gray
            table.merge_cells(dashboard, 1, current_row, cols - 1, current_row)
            table.cell(dashboard, 1, current_row, rsiText, text_halign=text.align_right, text_color=rsiColor, text_size=label_size)
            current_row += 1
            
            table.cell(dashboard, 0, current_row, "Pending", text_color=dc_gray, text_size=label_size)
            table.merge_cells(dashboard, 1, current_row, cols - 1, current_row)
            table.cell(dashboard, 1, current_row, livePending ? "YES (" + (not na(livePeakProb) ? "Pk" + str.tostring(livePeakProb, "#.#") : "Vy" + str.tostring(liveValleyProb, "#.#")) + "%)" : "NO", text_halign=text.align_right, text_color=livePending ? dc_gold : dc_gray, text_size=value_size)
            current_row += 1
            
            table.cell(dashboard, 0, current_row, "Predictive Mode", text_color=dc_gray, text_size=label_size)
            table.merge_cells(dashboard, 1, current_row, cols - 1, current_row)
            table.cell(dashboard, 1, current_row, predictiveMode ? "ON" : "OFF", text_halign=text.align_right, text_color=predictiveMode ? dc_green : dc_red, text_size=value_size)
            current_row += 1
            table.cell(dashboard, 0, current_row, "Last Signal", text_color=dc_gray, text_size=label_size)
            table.cell(dashboard, 1, current_row, lastSignalType, text_halign=text.align_right, text_color=lastSignalType == "Valley" ? dc_green : lastSignalType == "Peak" ? dc_red : dc_gray, text_size=label_size)
            table.cell(dashboard, 2, current_row, "Bars Since", text_color=dc_gray, text_size=label_size)
            table.cell(dashboard, 3, current_row, not na(barsSinceSignal) ? str.tostring(barsSinceSignal) : "—", text_halign=text.align_right, text_color=dc_white, text_size=label_size)
            current_row += 1
            table.cell(dashboard, 0, current_row, "Entropy Particles", text_color=dc_gray, text_size=label_size)
            table.merge_cells(dashboard, 1, current_row, cols - 1, current_row)
            table.cell(dashboard, 1, current_row, showEntropyParticles ? "ON (Strength: " + str.tostring(1.0 - entropy, "#.#") + ")" : "OFF", text_halign=text.align_right, text_color=showEntropyParticles ? dc_purple : dc_gray, text_size=value_size)
            current_row += 1

        // ═══ PHASE 2 — SIGNAL LEDGER: realized hit rate & expectancy per signal type ═══
        if dashboard_size == "Large" or isMobile
            if not isMobile
                table.merge_cells(dashboard, 0, current_row, cols - 1, current_row)
                table.cell(dashboard, 0, current_row, "═══ 📐 SIGNAL LEDGER (realized) ═══", text_halign=text.align_center, text_color=dc_gold, bgcolor=bg_section, text_size=label_size)
                current_row += 1
                table.cell(dashboard, 0, current_row, "Type", text_color=dc_gray, text_size=label_size)
                table.cell(dashboard, 1, current_row, "Rolling Hit%", text_halign=text.align_right, text_color=dc_gray, text_size=label_size)
                table.cell(dashboard, 2, current_row, "ExpR net", text_halign=text.align_right, text_color=dc_gray, text_size=label_size)
                table.cell(dashboard, 3, current_row, "N", text_halign=text.align_right, text_color=dc_gray, text_size=label_size)
                current_row += 1

            string[] sigTypes   = array.from("RPD_Peak", "RPD_Valley", "FVG_Bull", "FVG_Bear", "LIQ_Bear", "LIQ_Bull", "EXH_Buy", "EXH_Sell", "RegOB_Bull", "RegOB_Bear", "SWP_PDH", "SWP_PDL", "SWP_PWH", "SWP_PWL", "OF_ImbUp", "OF_ImbDn", "OF_AbsHi", "OF_AbsLo")
            string[] sigLabels  = array.from("RPD Peak", "RPD Valley", "FVG Bull", "FVG Bear", "LIQ Bear", "LIQ Bull", "EXH Buy", "EXH Sell", "RegOB B", "RegOB Br", "SWP PDH", "SWP PDL", "SWP PWH", "SWP PWL", "OF Δ↑", "OF Δ↓", "OF Abs↓", "OF Abs↑")
            for i = 0 to array.size(sigTypes) - 1
                string st = array.get(sigTypes, i)
                string lb = array.get(sigLabels, i)
                // WP-C2 fix: source n from the WINDOWED calibration sample (f_calStats), not the
                // all-history ledger count. Taking % and n from the same f_calStats call keeps them
                // consistent by construction — an all-history n next to a windowed % misleads the
                // user into trusting a small-sample estimate because n looks large.
                [ledgerCalPct, ledgerCalN] = f_calStats(st)
                float hr     = ledgerCalPct
                int   n      = ledgerCalN
                float ex     = f_expectancyR(st)
                bool  warm   = n < minCalSamples
                color hrCol  = warm or na(ex) ? dc_gray : hr >= 55 ? dc_green : hr >= 45 ? dc_gold : dc_red
                color exCol  = warm or na(ex) ? dc_gray : ex > 0 ? dc_green : ex < 0 ? dc_red : dc_gray
                color rowBg  = (i % 2 == 0) ? bg_alt : color.new(c_table_bg, 100)
                if isMobile
                    float exG = f_expectancyRGross(st)
                    table.merge_cells(dashboard, 0, current_row, cols - 1, current_row)
                    table.cell(dashboard, 0, current_row, lb + "  " + str.tostring(hr, "#") + "%" + (warm ? "(warmup)" : "") + "  R:" + (na(ex) ? "—" : str.tostring(ex, "#.##") + "(g" + str.tostring(exG, "#.##") + ")") + "  n:" + str.tostring(n), text_halign=text.align_right, text_color=hrCol, bgcolor=rowBg, text_size=label_size)
                else
                    table.cell(dashboard, 0, current_row, lb, text_color=dc_white, bgcolor=rowBg, text_size=label_size)
                    table.cell(dashboard, 1, current_row, n > 0 ? str.tostring(hr, "#") + "%" + (warm ? "(w)" : "") : "—", text_halign=text.align_right, text_color=hrCol, bgcolor=rowBg, text_size=label_size)
                    table.cell(dashboard, 2, current_row, na(ex) ? "—" : str.tostring(ex, "#.##") + (warm ? "(w)" : ""), text_halign=text.align_right, text_color=exCol, bgcolor=rowBg, text_size=label_size)
                    table.cell(dashboard, 3, current_row, str.tostring(n), text_halign=text.align_right, text_color=dc_gray, bgcolor=rowBg, text_size=label_size)
                current_row += 1

            int openCount = array.size(openLedger)
            if not isMobile
                table.cell(dashboard, 0, current_row, "Open Records", text_color=dc_gray, text_size=label_size)
                table.merge_cells(dashboard, 1, current_row, cols - 1, current_row)
                table.cell(dashboard, 1, current_row, str.tostring(openCount) + "  (horizon " + str.tostring(evalHorizon) + "b)", text_halign=text.align_right, text_color=dc_aqua, text_size=label_size)
                current_row += 1
