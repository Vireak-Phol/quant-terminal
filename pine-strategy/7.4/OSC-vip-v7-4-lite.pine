// ════════════════════════════════════════════════════════════════
// 1c. LIQUIDITY VACUUM ENGINE INPUTS
// ════════════════════════════════════════════════════════════════
// A "vacuum" is an UNTRADED price pocket the market must traverse to reach resting
// liquidity — equal highs/lows, an unfilled FVG, or the displacement void left by an
// impulse. Banks do not seek liquidity where volume has already been accepted; they
// seek the thin air *in front of* the stop pool, because price accelerates through it.
G_VAC = "🌀 Liquidity Vacuum (Big-Player Seek Zones)"
bool  vacEnable      = input.bool(true,  "Enable Vacuum Engine", group=G_VAC, tooltip="Detect untraded price pockets (equal highs/lows, unfilled FVGs, displacement voids) where institutional players seek liquidity before reversal.")
bool  vacShowZones   = input.bool(true,  "Show Vacuum Zones (price)", group=G_VAC, tooltip="Price-projected vacuum boxes + magnet line, drawn on the main chart from this sub-pane via force_overlay.")
bool  vacShowOsc     = input.bool(true,  "Show Vacuum Oscillator Band", group=G_VAC, tooltip="Sub-pane ±1 plot of signed vacuum pressure / magnet direction.")
int   vacPivotLen    = input.int(5,      "Vacuum Pivot Length", minval=2, maxval=20, group=G_VAC)
float vacClustTolAtr = input.float(0.30, "Equal High/Low Tolerance (x ATR)", minval=0.05, step=0.05, group=G_VAC, tooltip="Two pivots within this distance count as one clustered stop pool (a stronger vacuum magnet).")
int   vacLookback    = input.int(150,    "Vacuum Lookback (bars)", minval=30, maxval=500, group=G_VAC)
int   vacDispLen     = input.int(3,      "Displacement Candle Window", minval=2, maxval=6, group=G_VAC, tooltip="Bars that must hold an impulse imbalance for it to register as a displacement void.")
float vacFvgMinAtr   = input.float(0.20, "Vacuum FVG Min Size (x ATR)", minval=0.05, step=0.05, group=G_VAC, tooltip="Minimum gap to register as a vacuum void. Gold 5m/15m: ~0.2x ATR.")
float vacProxAtr     = input.float(1.5,  "Magnet Proximity (x ATR)", minval=0.25, step=0.25, group=G_VAC, tooltip="A vacuum within this distance of price is an ACTIVE magnet pulling price toward it.")
int   vacMaxZones    = input.int(3,      "Max Active Vacuum Zones / side", minval=1, maxval=6, group=G_VAC, tooltip="Caps box usage on the free tier.")

